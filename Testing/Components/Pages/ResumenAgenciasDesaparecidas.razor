@using System.Globalization
@using Testing.Application.GetAllViajes

<section class="re-bloque re-agencias">
    <h3>Agencias que ya no aparecen</h3>

    @if (Agencias.Count == 0)
    {
        <p class="re-vacio">Ninguna agencia dejó de aparecer en @MesUltimo.</p>
    }
    else
    {
        <div class="re-tbl-wrap">
            <table class="re-tabla">
                <thead>
                    <tr><th>Destino</th><th>Matriz</th><th>Último mes activo</th><th>Meses activa</th><th>Venta acumulada</th><th>Venta promedio/mes</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Agencias)
                    {
                        <tr>
                            <td>@a.Destino</td>
                            <td>@a.Matriz</td>
                            <td>@a.UltimoMesActivo.Etiqueta</td>
                            <td class="align-end tabular">@FormatoNumero(a.MesesActiva)</td>
                            <td class="align-end tabular re-neg">@FormatoDinero(a.VentaAcumulada)</td>
                            <td class="align-end tabular">@FormatoDinero(a.VentaPromedio)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="re-nota">@Agencias.Count agencia(s) que tuvieron viajes en algún mes cerrado pero no en @MesUltimo. Venta acumulada = suma de venta en los meses en que SÍ tuvieron actividad.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AgenciaDesaparecidaDto> Agencias { get; set; } = [];
    [Parameter] public string? MesUltimo { get; set; }

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");
    private static string FormatoNumero(int v) => v.ToString("N0", Cultura);
    private static string FormatoDinero(decimal v) => v.ToString("C0", Cultura);
}