@using System.Globalization
@using Testing.Features

@if (columnas.Count == 0)
{
    <p class="aj-sin-metricas">Selecciona al menos una métrica en la barra superior.</p>
}
else
{
    <div class="aj-wrap">
        <table class="aj-table">
            <thead>
                <tr>
                    <th class="aj-th-dim @(ordenDescendente ? "is-desc" : "is-asc")" rowspan="2" @onclick="AlternarOrden" title="Ordenar alfabéticamente">@EtiquetaJerarquia</th>
                    @if (!SoloComparativa)
                    {
                        @foreach (var mes in Meses)
                        {
                            @if (MesColapsado(mes.Clave))
                            {
                                <th class="aj-mes-colapsado" rowspan="2" @onclick="@(() => ToggleMes(mes.Clave))" title="Mostrar @mes.Etiqueta">▸</th>
                            }
                            else
                            {
                                <th class="aj-mes-header" colspan="@columnas.Count" @onclick="@(() => ToggleMes(mes.Clave))" title="Ocultar @mes.Etiqueta">@mes.Etiqueta ▾</th>
                            }
                        }
                    }
                    @if (MesA is not null && MesB is not null)
                    {
                        <th class="aj-cmp-header" colspan="@(columnas.Count * 2)">Δ @EtiquetaMes(MesB) vs @EtiquetaMes(MesA)</th>
                    }
                </tr>
                <tr>
                    @if (!SoloComparativa)
                    {
                        @foreach (var mes in Meses)
                        {
                            @if (!MesColapsado(mes.Clave))
                            {
                                @for (var ci = 0; ci < columnas.Count; ci++)
                                {
                                    <th class="align-end @(ci == 0 ? "aj-mes0" : "")">@columnas[ci].Etiqueta</th>
                                }
                            }
                        }
                    }
                    @if (MesA is not null && MesB is not null)
                    {
                        @for (var ci = 0; ci < columnas.Count; ci++)
                        {
                            <th class="align-end aj-cmp @(ci == 0 ? "aj-cmp-start" : "")">Δ @columnas[ci].Etiqueta</th>
                            <th class="align-end aj-cmp @(ci == columnas.Count - 1 ? "aj-cmp-end" : "")">%</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Aplanar())
                {
                    <tr>
                        <td class="aj-lvl-@fila.Nivel" style="padding-left:@(8 + fila.Nivel * 16)px;">
                            @if (!fila.EsHoja)
                            {
                                <span class="aj-flecha" @onclick="@(() => Alternar(fila.Nodo))">@(fila.Nodo.IsExpanded ? "▾" : "▸")</span>
                                <span class="aj-label" @onclick="@(() => Alternar(fila.Nodo))">@fila.Label</span>
                                <span class="aj-cuenta">(@fila.Nodo.Hijos.Count)</span>
                            }
                            else
                            {
                                <span class="aj-flecha-vacia"></span>
                                <span class="aj-label">@fila.Label</span>
                            }
                        </td>
                        @if (!SoloComparativa)
                        {
                            @for (var mi = 0; mi < Meses.Count; mi++)
                            {
                                var mes = Meses[mi];
                                @if (!MesColapsado(mes.Clave))
                                {
                                    var metricasMes = fila.Nodo.ObtenerMes(mes.Clave);
                                    var metricasMesAnterior = mi > 0 ? fila.Nodo.ObtenerMes(Meses[mi - 1].Clave) : null;
                                    var esPrimerMes = mi == 0;
                                    @for (var ci = 0; ci < columnas.Count; ci++)
                                    {
                                        var col = columnas[ci];
                                        var valorActual = col.Selector(metricasMes);
                                        var valorAnterior = metricasMesAnterior is null ? 0 : col.Selector(metricasMesAnterior);
                                        <td class="align-end tabular aj-lvl-@fila.Nivel @(ci == 0 ? "aj-mes0" : "") @(col.EsSumable ? ClaseCelda(valorActual, valorAnterior, esPrimerMes) : "")">
                                            @col.Formato(valorActual)
                                            @if (MostrarParticipacion && col.EsSumable)
                                            {
                                                <span class="aj-pct">@FormatoPorcentaje(Participacion(valorActual, col.Selector(Raiz.ObtenerMes(mes.Clave))))</span>
                                            }
                                        </td>
                                    }
                                }
                            }
                        }
                        @if (MesA is not null && MesB is not null)
                        {
                            var a = fila.Nodo.ObtenerMes(MesA);
                            var b = fila.Nodo.ObtenerMes(MesB);
                            @for (var ci = 0; ci < columnas.Count; ci++)
                            {
                                var col = columnas[ci];
                                var va = col.Selector(a);
                                var vb = col.Selector(b);
                                <td class="align-end tabular aj-cmp @(ci == 0 ? "aj-cmp-start" : "") @ClaseDelta(va, vb)">@FormatoDeltaCelda(va, vb, col.Formato)</td>
                                <td class="align-end tabular aj-cmp @(ci == columnas.Count - 1 ? "aj-cmp-end" : "") @ClaseDelta(va, vb)">@FormatoPctCelda(va, vb)</td>
                            }
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="aj-total">
                    <td>TOTAL</td>
                    @if (!SoloComparativa)
                    {
                        @foreach (var mes in Meses)
                        {
                            @if (!MesColapsado(mes.Clave))
                            {
                                var totalMes = Raiz.ObtenerMes(mes.Clave);
                                @for (var ci = 0; ci < columnas.Count; ci++)
                                {
                                    <td class="align-end tabular @(ci == 0 ? "aj-mes0" : "")">@columnas[ci].Formato(columnas[ci].Selector(totalMes))</td>
                                }
                            }
                        }
                    }
                    @if (MesA is not null && MesB is not null)
                    {
                        var totalA = Raiz.ObtenerMes(MesA);
                        var totalB = Raiz.ObtenerMes(MesB);
                        @for (var ci = 0; ci < columnas.Count; ci++)
                        {
                            var col = columnas[ci];
                            var va = col.Selector(totalA);
                            var vb = col.Selector(totalB);
                            <td class="align-end tabular aj-cmp @(ci == 0 ? "aj-cmp-start" : "")">@FormatoDeltaCelda(va, vb, col.Formato)</td>
                            <td class="align-end tabular aj-cmp @(ci == columnas.Count - 1 ? "aj-cmp-end" : "")">@FormatoPctCelda(va, vb)</td>
                        }
                    }
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public NodoJerarquia Raiz { get; set; } = null!;
    [Parameter, EditorRequired] public List<MesColumna> Meses { get; set; } = [];
    [Parameter] public string EtiquetaJerarquia { get; set; } = "Cliente › Zona › Matriz › Sucursal";
    [Parameter] public int ProfundidadMaxima { get; set; } = 4;
    [Parameter] public bool MostrarViajes { get; set; } = true;
    [Parameter] public bool MostrarKms { get; set; } = true;
    [Parameter] public bool MostrarPeaje { get; set; } = true;
    [Parameter] public bool MostrarVenta { get; set; } = true;
    [Parameter] public bool MostrarPkm { get; set; } = true;
    [Parameter] public bool MostrarKmPorViaje { get; set; } = true;
    [Parameter] public bool MostrarPvj { get; set; } = true;
    [Parameter] public bool MostrarParticipacion { get; set; }
    [Parameter] public bool SoloComparativa { get; set; }

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");

    private sealed record ColumnaMetrica(string Clave, string Etiqueta, Func<MetricasMes, decimal> Selector, Func<decimal, string> Formato, bool EsSumable);

    private List<ColumnaMetrica> columnas = [];
    private bool ordenDescendente;
    private readonly HashSet<string> mesesColapsados = [];

    protected override void OnParametersSet()
    {
        columnas = [];
        if (MostrarViajes) columnas.Add(new("viajes", "Viajes", m => m.Viajes, FormatoNumero, true));
        if (MostrarKms) columnas.Add(new("kms", "KMS", m => m.Km, FormatoNumero, true));
        if (MostrarPeaje) columnas.Add(new("peaje", "Peaje", m => m.Peaje, FormatoDinero, true));
        if (MostrarVenta) columnas.Add(new("venta", "Venta", m => m.Venta, FormatoDinero, true));
        if (MostrarPkm) columnas.Add(new("pkm", "$/KM", m => m.VentaPorKm, FormatoDinero, false));
        if (MostrarKmPorViaje) columnas.Add(new("kmv", "km/Viaje", m => m.KmPorViaje, FormatoNumero, false));
        if (MostrarPvj) columnas.Add(new("pvj", "$/Viaje", m => m.VentaPorViaje, FormatoDinero, false));
    }

    private string? MesA => Meses.Count >= 2 ? Meses[^2].Clave : null;
    private string? MesB => Meses.Count >= 1 ? Meses[^1].Clave : null;

    private string EtiquetaMes(string clave) => Meses.FirstOrDefault(m => m.Clave == clave)?.Etiqueta ?? clave;

    private bool MesColapsado(string clave) => mesesColapsados.Contains(clave);

    private void ToggleMes(string clave)
    {
        if (!mesesColapsados.Remove(clave))
            mesesColapsados.Add(clave);
    }

    private void Alternar(NodoJerarquia nodo) => nodo.IsExpanded = !nodo.IsExpanded;

    private void AlternarOrden() => ordenDescendente = !ordenDescendente;

    public void ExpandirTodo()
    {
        AplicarATodos(Raiz, expandir: true);
        StateHasChanged();
    }

    public void ColapsarTodo()
    {
        AplicarATodos(Raiz, expandir: false);
        StateHasChanged();
    }

    private static void AplicarATodos(NodoJerarquia nodo, bool expandir)
    {
        foreach (var hijo in nodo.Hijos.Values)
        {
            hijo.IsExpanded = expandir;
            AplicarATodos(hijo, expandir);
        }
    }

    private List<FilaArbol> Aplanar()
    {
        var filas = new List<FilaArbol>();
        Caminar(Raiz, 0, filas);
        return filas;
    }

    private void Caminar(NodoJerarquia nodo, int nivelFila, List<FilaArbol> filas)
    {
        var hijos = nodo.Hijos.Values.OrderBy(h => h.Label, StringComparer.CurrentCultureIgnoreCase).ToList();
        if (ordenDescendente)
            hijos.Reverse();

        foreach (var hijoOriginal in hijos)
        {
            var efectivo = hijoOriginal;
            var nivelEfectivo = nivelFila;
            while (nivelEfectivo < ProfundidadMaxima - 1 && efectivo.Hijos.Count == 1)
            {
                efectivo = efectivo.Hijos.Values.Single();
                nivelEfectivo++;
            }

            var esHoja = nivelEfectivo == ProfundidadMaxima - 1 || efectivo.Hijos.Count == 0;
            filas.Add(new FilaArbol(nivelFila, hijoOriginal.Id, hijoOriginal.Label, efectivo, esHoja));

            if (!esHoja && hijoOriginal.IsExpanded)
                Caminar(efectivo, nivelFila + 1, filas);
        }
    }

    private static decimal Participacion(decimal valor, decimal total) => total > 0 ? valor / total * 100 : 0;

    private static decimal PorcentajeCambio(decimal a, decimal b) => a != 0 ? (b - a) / a * 100 : 0;

    private static string FormatoDeltaCelda(decimal a, decimal b, Func<decimal, string> formato)
    {
        if (a == 0 && b == 0)
            return "—";

        var d = b - a;
        return (d >= 0 ? "+" : "-") + formato(Math.Abs(d));
    }

    private static string FormatoPctCelda(decimal a, decimal b)
    {
        if (a == 0)
            return b != 0 ? "nuevo" : "—";

        var pct = PorcentajeCambio(a, b);
        return (pct >= 0 ? "+" : "") + pct.ToString("0.0", Cultura) + "%";
    }

    private static string ClaseDelta(decimal a, decimal b)
    {
        if (a == 0 && b == 0)
            return "aj-neutro";
        if (a == b)
            return "aj-neutro";

        return b > a ? "aj-pos" : "aj-neg";
    }

    private static string ClaseCelda(decimal actual, decimal anterior, bool esPrimerMes)
    {
        if (esPrimerMes)
            return "aj-neutro";
        if (anterior == 0 || actual == 0)
            return "aj-neutro";
        if (actual == anterior)
            return "aj-neutro";

        return actual > anterior ? "aj-pos" : "aj-neg";
    }

    private static string FormatoPorcentaje(decimal v) => $" {v.ToString("0.0", Cultura)}%";

    private static string FormatoNumero(decimal v) => Math.Round(v).ToString("N0", Cultura);
    private static string FormatoDinero(decimal v) => v.ToString("C0", Cultura);
}