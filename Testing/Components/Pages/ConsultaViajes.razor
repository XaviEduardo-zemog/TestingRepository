@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using MediatR
@using Testing.Application.GetAllViajes
@using Testing.Features
@inject ISender Sender

<PageTitle>Viajes Zemog</PageTitle>

<div class="vz-page">

    <header class="vz-header">
        <div class="vz-header-text">
            <h1>Estado de la Operación</h1>
            <p class="vz-header-sub">@TextoCorte()</p>
        </div>
    </header>

    <section class="vz-toolbar" aria-label="Filtros de Viajes Zemog">
        <div class="vz-toolbar-primary">
            <div class="vz-field-group">
                <label for="vzDesde">Desde</label>
                <InputDate id="vzDesde" class="vz-date" @bind-Value="filtro.FechaInicio" />
            </div>
            <div class="vz-field-group">
                <label for="vzHasta">Hasta</label>
                <InputDate id="vzHasta" class="vz-date" @bind-Value="filtro.FechaFin" />
            </div>

            <div class="vz-field-group">
                <label for="vzAgrupar">Agrupar por</label>
                <select id="vzAgrupar" class="vz-select" @bind="agruparPor">
                    <option value="matriz">Matriz</option>
                    <option value="expedicion">Expedición</option>
                    <option value="operador">Operador</option>
                    <option value="unidad">Unidad</option>
                    <option value="dia">Día</option>
                </select>
            </div>

            @foreach (var f in FiltrosPrimarios)
            {
                <MultiSelectFiltro @key="f.Clave"
                                   Etiqueta="@f.Etiqueta"
                                   Opciones="@f.OpcionesDisponibles"
                                   Seleccionados="@f.Seleccionados"
                                   SeleccionadosChanged="@(nuevo => OnFiltroCambiadoAsync(f, nuevo))"
                                   Disponible="@f.Disponible"
                                   MotivoPendiente="@f.MotivoPendiente"
                                   ConBuscador="@f.ConBuscador"
                                   Abierto="@(filtroAbierto == f)"
                                   OnToggle="@(() => ToggleFiltro(f))" />
            }

            <button type="button" class="vz-btn" @onclick="ToggleMasFiltros" aria-expanded="@mostrarMasFiltros">
                @(mostrarMasFiltros ? "− Menos filtros" : "+ Más filtros")
            </button>

            <button type="button" class="vz-btn vz-btn-primary" @onclick="ConsultarAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="vz-spinner" aria-hidden="true"></span>
                }
                <span>@(isLoading ? "Consultando" : "Actualizar")</span>
            </button>
        </div>

        @if (mostrarMasFiltros)
        {
            <div class="vz-toolbar-secondary">
                @foreach (var f in FiltrosSecundarios)
                {
                    <MultiSelectFiltro @key="f.Clave"
                                       Etiqueta="@f.Etiqueta"
                                       Opciones="@f.OpcionesDisponibles"
                                       Seleccionados="@f.Seleccionados"
                                       SeleccionadosChanged="@(nuevo => OnFiltroCambiadoAsync(f, nuevo))"
                                       Disponible="@f.Disponible"
                                       MotivoPendiente="@f.MotivoPendiente"
                                       ConBuscador="@f.ConBuscador"
                                       Abierto="@(filtroAbierto == f)"
                                       OnToggle="@(() => ToggleFiltro(f))" />
                }
            </div>
        }
    </section>

    <div class="vz-metrics-bar" title="Controla el pivote de la Fase 3 — todavía no aplica a esta tabla de detalle">
        <label class="vz-metric-disabled"><input type="checkbox" disabled checked /> Viajes</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled checked /> KMS</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled /> Venta</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled /> $/km</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled /> km/Viaje</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled /> $/Viaje</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled /> % Part.</label>
        <label class="vz-metric-disabled"><input type="checkbox" disabled /> Solo comparativa</label>
    </div>

    <div class="vz-kpis">
        <KpiCard Title="Viajes" Value="@FormatoNumero(kpiViajes)" />
        <KpiCard Title="KMS" Value="@FormatoNumero(kpiKms)" />
        <div class="vz-kpi-pending">
            <KpiCard Title="Venta" Value="Pendiente" />
            <p class="vz-kpi-pending-note">Fuente no localizada — ver §54.20</p>
        </div>
        <KpiCard Title="km/Viaje" Value="@FormatoNumero(kpiKmPorViaje)" />
        <KpiCard Title="Peaje" Value="@FormatoDinero(kpiPeaje)" />
    </div>

    @if (errorMessage is not null)
    {
        <DataStateBanner Title="No fue posible consultar los viajes." Variant="Variant.Danger">
            <ChildContent>
                <p class="vz-state-subtitle">@errorMessage</p>
            </ChildContent>
            <Actions>
                <button type="button" class="vz-btn vz-btn-secondary" @onclick="ConsultarAsync">Reintentar</button>
            </Actions>
        </DataStateBanner>
    }
    else if (isLoading)
    {
        <LoadingSkeleton Rows="6" />
    }
    else if (seConsulto && viajesFiltrados.Count == 0)
    {
        <DataStateBanner Title="@(viajesCargados.Count == 0 ? "No hay datos para el rango seleccionado." : "No hay viajes con los filtros seleccionados.")">
            <ChildContent>
                <p class="vz-state-subtitle">@(viajesCargados.Count == 0 ? "Prueba ampliando el rango Desde/Hasta." : "Prueba limpiando algunos filtros.")</p>
            </ChildContent>
            <Actions>
                @if (viajesCargados.Count > 0)
                {
                    <button type="button" class="vz-btn vz-btn-secondary" @onclick="LimpiarTodosLosFiltros">Limpiar filtros</button>
                }
            </Actions>
        </DataStateBanner>
    }
    else if (viajesFiltrados.Count > 0)
    {
        <div class="vz-table-wrap">
            <table class="vz-table">
                <thead>
                    <tr>
                        <th>Base</th>
                        <th>No. viaje</th>
                        <th>Estatus</th>
                        <th>Unidad</th>
                        <th>Ruta</th>
                        <th>Operador</th>
                        <th>Fecha ingreso</th>
                        <th class="align-end">Diésel cargado</th>
                        <th class="align-end">Costo diésel</th>
                        <th>Factura</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var viaje in viajesFiltrados)
                    {
                        <tr>
                            <td>@viaje._base</td>
                            <td>@viaje.no_viaje</td>
                            <td><StatusBadge Text="@viaje.estatus_viaje" Variant="EstadoVariant(viaje.estatus_viaje)" /></td>
                            <td>@viaje.id_unidad</td>
                            <td>@viaje.ruta</td>
                            <td>@viaje.operador1</td>
                            <td>@viaje.fecha_ingreso</td>
                            <td class="align-end tabular">@viaje.diesel_cargado</td>
                            <td class="align-end tabular">@viaje.costo_diesel</td>
                            <td>@viaje.factura</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="vz-total">
                        <td colspan="7">@viajesFiltrados.Count registro@(viajesFiltrados.Count == 1 ? "" : "s")</td>
                        <td class="align-end tabular">@FormatoDecimal(viajesFiltrados.Sum(v => v.diesel_cargado ?? 0))</td>
                        <td class="align-end tabular">@FormatoDinero(viajesFiltrados.Sum(v => v.costo_diesel ?? 0))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

</div>

@code {
    private readonly ConsultaViajesFilterModel filtro = new();

    private List<ViajesDto> viajesCargados = [];
    private List<ViajesDto> viajesFiltrados = [];
    private bool isLoading;
    private bool seConsulto;
    private bool mostrarMasFiltros;
    private string? errorMessage;
    private string agruparPor = "matriz";

    private List<FiltroZemog> filtros = [];
    private FiltroZemog? filtroAbierto;

    private IEnumerable<FiltroZemog> FiltrosPrimarios => filtros.Take(5);
    private IEnumerable<FiltroZemog> FiltrosSecundarios => filtros.Skip(5);

    private int kpiViajes;
    private decimal kpiKms;
    private decimal kpiKmPorViaje;
    private decimal kpiPeaje;

    private sealed class FiltroZemog
    {
        public required string Clave { get; init; }
        public required string Etiqueta { get; init; }
        public required Func<ViajesDto, string?> Selector { get; init; }
        public bool Disponible { get; init; } = true;
        public string? MotivoPendiente { get; init; }
        public bool ConBuscador { get; init; }
        public HashSet<string> Seleccionados { get; set; } = [];
        public List<string> OpcionesDisponibles { get; set; } = [];
    }

    protected override void OnInitialized()
    {
        // Orden exacto de cascada de viajes_v14.html (KEYS_P.concat(KEYS_S)).
        filtros =
        [
            new() { Clave = "cliente", Etiqueta = "Cliente", Selector = _ => null, Disponible = false, ConBuscador = true,
                    MotivoPendiente = "Pendiente de backend: requiere columna tipo_operacion, no confirmada en el SP actual — ver §54.20/§54.21" },
            new() { Clave = "sucursal", Etiqueta = "Sucursal", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente de backend: granularidad más fina que Matriz (_base), sin confirmar — ver §54.21" },
            new() { Clave = "mes", Etiqueta = "Mes", Selector = ObtenerMesEtiqueta },
            new() { Clave = "destino", Etiqueta = "Destino", Selector = _ => null, Disponible = false, ConBuscador = true,
                    MotivoPendiente = "Pendiente: requiere una regla de parseo de Ruta validada en Application, no un parser ad-hoc en Presentation — ver §54.20" },
            new() { Clave = "expedicion", Etiqueta = "Expedición", Selector = v => v.expedicion },
            new() { Clave = "zona", Etiqueta = "Zona", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente de backend: requiere columna tipo_operacion — ver §54.20" },
            new() { Clave = "matriz", Etiqueta = "Matriz", Selector = v => v._base },
            new() { Clave = "anio", Etiqueta = "Año", Selector = v => ObtenerFecha(v)?.Year.ToString() },
            new() { Clave = "semana", Etiqueta = "Semana", Selector = ObtenerSemana },
            new() { Clave = "edestino", Etiqueta = "Edo. Destino", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente: depende de que Destino se resuelva primero en Application — ver §54.20" },
            new() { Clave = "operador", Etiqueta = "Operador", Selector = v => v.operador1, ConBuscador = true },
            new() { Clave = "unidad", Etiqueta = "Unidad", Selector = v => v.id_unidad, ConBuscador = true },
            new() { Clave = "tarifa", Etiqueta = "Tipo de tarifa", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente: tarifaDeRuta() del HTML asume un formato de Ruta distinto al confirmado — ver §54.20" },
            new() { Clave = "movimiento", Etiqueta = "Movimiento", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente: se derivaría parseando Ruta igual que Destino/Tarifa — mismo riesgo de parser no validado, se resuelve junto con esos" },
        ];
    }

    private void ToggleMasFiltros() => mostrarMasFiltros = !mostrarMasFiltros;

    private void ToggleFiltro(FiltroZemog f) => filtroAbierto = filtroAbierto == f ? null : f;

    private Task OnFiltroCambiadoAsync(FiltroZemog f, HashSet<string> nuevaSeleccion)
    {
        f.Seleccionados = nuevaSeleccion;
        RecalcularCascada(f.Clave);
        viajesFiltrados = ObtenerViajesFiltrados();
        CalcularKpis();
        return Task.CompletedTask;
    }

    private void LimpiarTodosLosFiltros()
    {
        foreach (var f in filtros)
            f.Seleccionados.Clear();

        RecalcularCascada(null);
        viajesFiltrados = ObtenerViajesFiltrados();
        CalcularKpis();
    }

    // TEMPORAL MVP: cascada calculada en memoria sobre viajesCargados (el resultado
    // ya traído por GetViajesQuery). FINAL: si el volumen de datos crece, mover el
    // cálculo de opciones disponibles a Application/SQL (ver §54.27).
    private void RecalcularCascada(string? claveModificada)
    {
        if (claveModificada is null)
        {
            foreach (var f in filtros.Where(f => f.Disponible))
            {
                f.OpcionesDisponibles = CalcularOpciones(viajesCargados, f);
                f.Seleccionados.IntersectWith(f.OpcionesDisponibles);
            }
            return;
        }

        var pasoElCambio = false;
        var filtrado = viajesCargados;

        foreach (var f in filtros)
        {
            if (f.Disponible && f.Seleccionados.Count > 0)
                filtrado = filtrado.Where(v => f.Selector(v) is { } val && f.Seleccionados.Contains(val)).ToList();

            if (f.Clave == claveModificada)
                pasoElCambio = true;

            if (pasoElCambio && f.Clave != claveModificada && f.Disponible)
            {
                f.OpcionesDisponibles = CalcularOpciones(filtrado, f);
                f.Seleccionados.IntersectWith(f.OpcionesDisponibles);
            }
        }
    }

    private static List<string> CalcularOpciones(IEnumerable<ViajesDto> datos, FiltroZemog f) =>
        datos.Select(f.Selector)
             .Where(v => !string.IsNullOrWhiteSpace(v))
             .Select(v => v!)
             .Distinct()
             .OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase)
             .ToList();

    private List<ViajesDto> ObtenerViajesFiltrados()
    {
        var resultado = viajesCargados;

        foreach (var f in filtros.Where(f => f.Disponible && f.Seleccionados.Count > 0))
            resultado = resultado.Where(v => f.Selector(v) is { } val && f.Seleccionados.Contains(val)).ToList();

        return resultado;
    }

    private async Task ConsultarAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var query = new GetViajesQuery(
                filtro.FechaInicio, filtro.FechaFin, filtro.TipoFecha,
                filtro.Areas, filtro.IdUnidad, filtro.Estados,
                filtro.IdRuta, filtro.IdOperador, filtro.NoRemision);

            var resultado = await Sender.Send(query);

            if (resultado.IsFailure)
            {
                errorMessage = resultado.Error.Message;
                viajesCargados = [];
            }
            else
            {
                viajesCargados = resultado.Value.ToList();
            }
        }
        catch (FluentValidation.ValidationException vex)
        {
            errorMessage = string.Join(" ", vex.Errors.Select(e => e.ErrorMessage));
            viajesCargados = [];
        }
        catch (Exception)
        {
            errorMessage = "Intenta nuevamente en unos segundos.";
            viajesCargados = [];
        }
        finally
        {
            isLoading = false;
            seConsulto = true;
            RecalcularCascada(null);
            viajesFiltrados = ObtenerViajesFiltrados();
            CalcularKpis();
        }
    }

    private void CalcularKpis()
    {
        kpiViajes = viajesFiltrados.Count;
        kpiKms = viajesFiltrados.Sum(v => v.kms_viaje ?? 0);
        kpiKmPorViaje = kpiViajes > 0 ? kpiKms / kpiViajes : 0;
        kpiPeaje = viajesFiltrados.Sum(v => (v.peaje_efectivo ?? 0) + (v.peaje_electronico ?? 0));
    }

    private static string FormatoNumero(decimal v) => Math.Round(v).ToString("N0", Cultura);
    private static string FormatoNumero(int v) => v.ToString("N0", Cultura);
    private static string FormatoDinero(decimal v) => v.ToString("C0", Cultura);
    private static string FormatoDecimal(decimal v) => v.ToString("N1", Cultura);

    private static readonly string[] FormatosFechaIngreso = ["d/M/yyyy h:mm tt"];

    private static DateTime? ObtenerFecha(ViajesDto v)
    {
        if (string.IsNullOrWhiteSpace(v.fecha_ingreso))
            return null;

        if (DateTime.TryParseExact(v.fecha_ingreso, FormatosFechaIngreso, CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
            return fecha;

        if (DateTime.TryParse(v.fecha_ingreso, CultureInfo.InvariantCulture, DateTimeStyles.None, out fecha))
            return fecha;

        return null;
    }

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");

    private static string? ObtenerMesEtiqueta(ViajesDto v)
    {
        var fecha = ObtenerFecha(v);
        return fecha is null ? null : Cultura.TextInfo.ToTitleCase(fecha.Value.ToString("MMM yyyy", Cultura));
    }

    private static string? ObtenerSemana(ViajesDto v)
    {
        var fecha = ObtenerFecha(v);
        return fecha is null ? null : ISOWeek.GetWeekOfYear(fecha.Value).ToString();
    }

    private string TextoCorte()
    {
        var cultura = Cultura;

        if (!seConsulto)
            return $"Rango a consultar: {filtro.FechaInicio.ToString("dd MMM yyyy", cultura)} – {filtro.FechaFin.ToString("dd MMM yyyy", cultura)}";

        if (viajesCargados.Count == 0)
            return "Sin viajes en el rango consultado";

        var fechas = viajesCargados.Select(ObtenerFecha).Where(f => f is not null).Select(f => f!.Value).ToList();
        var corte = fechas.Count > 0 ? fechas.Max().ToString("dd MMM yyyy", cultura) : "sin fecha reconocible";

        return $"Corte: {corte} · {viajesCargados.Count} viajes cargados en el rango consultado";
    }

    private static Variant EstadoVariant(string? estatus) => estatus?.Trim().ToUpperInvariant() switch
    {
        "ACTIVO" or "EN RUTA" or "EN TRANSITO" or "EN TRÁNSITO" => Variant.Info,
        "FINALIZADO" or "COMPLETADO" or "ENTREGADO" => Variant.Success,
        "CANCELADO" or "RECHAZADO" => Variant.Danger,
        "PENDIENTE" or "EN ESPERA" => Variant.Warning,
        _ => Variant.Neutral,
    };
}