@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using MediatR
@using Testing.Application.GetAllViajes
@using Testing.Features
@inject ISender Sender

<PageTitle>Viajes Zemog</PageTitle>

<div class="vz-page">

    <header class="vz-header">
        <div class="vz-header-text">
            <h1>Estado de la Operación</h1>
            <p class="vz-header-sub">@TextoCorte()</p>
        </div>
        <button type="button" class="vz-btn vz-btn-secondary" @onclick="() => mostrarResumen = !mostrarResumen">
            @(mostrarResumen ? "← Volver a la consulta" : "Resumen Ejecutivo")
        </button>
    </header>

    @if (mostrarResumen)
    {
        <ResumenEjecutivo Viajes="viajesCargados" Corte="corte" />
    }
    else
    {

        <section class="vz-toolbar" aria-label="Filtros de Viajes Zemog">
            <div class="vz-toolbar-primary">
                <div class="vz-field-group">
                    <label for="vzDesde">Desde</label>
                    <InputDate id="vzDesde" class="vz-date" @bind-Value="filtro.FechaInicio" />
                </div>
                <div class="vz-field-group">
                    <label for="vzHasta">Hasta</label>
                    <InputDate id="vzHasta" class="vz-date" @bind-Value="filtro.FechaFin" />
                </div>

                <div class="vz-field-group">
                    <label for="vzAgrupar">Agrupar por</label>
                    <select id="vzAgrupar" class="vz-select" @bind="agruparPor" @bind:after="RecalcularPivote">
                        <option value="cliente">Cliente</option>
                        <option value="zona">Zona</option>
                        <option value="matriz">Matriz</option>
                        <option value="expedicion">Expedición</option>
                        <option value="operador">Operador</option>
                        <option value="unidad">Unidad</option>
                        <option value="ruta">Ruta</option>
                        <option value="destino">Destino</option>
                        <option value="movimiento">Movimiento</option>
                        <option value="semana">Semana</option>
                        <option value="dia">Día</option>
                        <option value="jerarquia">Jerarquía (Cliente › Zona › Matriz › Sucursal)</option>
                    </select>
                </div>

                @foreach (var f in FiltrosPrimarios)
                {
                    <MultiSelectFiltro @key="f.Clave"
                                       Etiqueta="@f.Etiqueta"
                                       Opciones="@f.OpcionesDisponibles"
                                       Seleccionados="@f.Seleccionados"
                                       SeleccionadosChanged="@(nuevo => OnFiltroCambiadoAsync(f, nuevo))"
                                       Disponible="@f.Disponible"
                                       MotivoPendiente="@f.MotivoPendiente"
                                       ConBuscador="@f.ConBuscador"
                                       Abierto="@(filtroAbierto == f)"
                                       OnToggle="@(() => ToggleFiltro(f))" />
                }

                <button type="button" class="vz-btn" @onclick="ToggleMasFiltros" aria-expanded="@mostrarMasFiltros">
                    @(mostrarMasFiltros ? "− Menos filtros" : "+ Más filtros")
                </button>

                <button type="button" class="vz-btn vz-btn-primary" @onclick="ConsultarAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="vz-spinner" aria-hidden="true"></span>
                    }
                    <span>@(isLoading ? "Consultando" : "Actualizar")</span>
                </button>
            </div>

            @if (mostrarMasFiltros)
            {
                <div class="vz-toolbar-secondary">
                    @foreach (var f in FiltrosSecundarios)
                    {
                        <MultiSelectFiltro @key="f.Clave"
                                           Etiqueta="@f.Etiqueta"
                                           Opciones="@f.OpcionesDisponibles"
                                           Seleccionados="@f.Seleccionados"
                                           SeleccionadosChanged="@(nuevo => OnFiltroCambiadoAsync(f, nuevo))"
                                           Disponible="@f.Disponible"
                                           MotivoPendiente="@f.MotivoPendiente"
                                           ConBuscador="@f.ConBuscador"
                                           Abierto="@(filtroAbierto == f)"
                                           OnToggle="@(() => ToggleFiltro(f))" />
                    }
                </div>
            }
        </section>

        <div class="vz-metrics-bar">
            <label><input type="checkbox" @bind="mostrarViajes" /> Viajes</label>
            <label><input type="checkbox" @bind="mostrarKms" /> KMS</label>
            <label><input type="checkbox" @bind="mostrarPeaje" /> Peaje</label>
            <label class="vz-metric-disabled" title="Fuente no localizada — ver §54.20"><input type="checkbox" disabled /> Venta</label>
            <label class="vz-metric-disabled" title="Requiere Venta"><input type="checkbox" disabled /> $/km</label>
            <label><input type="checkbox" @bind="mostrarKmPorViaje" /> km/Viaje</label>
            <label class="vz-metric-disabled" title="Requiere Venta"><input type="checkbox" disabled /> $/Viaje</label>
            <label class="vz-metric-sep"><input type="checkbox" @bind="mostrarParticipacion" /> % Part.</label>
            <label><input type="checkbox" @bind="soloComparativa" /> Solo comparativa</label>
        </div>

        <div class="vz-kpis">
            @foreach (var kpi in kpisComparativa)
            {
                @if (kpi.Disponible)
                {
                    <KpiCard Title="@TituloKpi(kpi)"
                             Value="@ValorKpi(kpi)"
                             Delta="@DeltaKpi(kpi)"
                             DeltaVariant="@VarianteKpi(kpi)" />
                }
                else
                {
                    <div class="vz-kpi-pending">
                        <KpiCard Title="@kpi.Etiqueta" Value="Pendiente" />
                        <p class="vz-kpi-pending-note">@kpi.MotivoPendiente</p>
                    </div>
                }
            }
        </div>

        @if (errorMessage is not null)
        {
            <DataStateBanner Title="No fue posible consultar los viajes." Variant="Variant.Danger">
                <ChildContent>
                    <p class="vz-state-subtitle">@errorMessage</p>
                </ChildContent>
                <Actions>
                    <button type="button" class="vz-btn vz-btn-secondary" @onclick="ConsultarAsync">Reintentar</button>
                </Actions>
            </DataStateBanner>
        }
        else if (isLoading)
        {
            <LoadingSkeleton Rows="6" />
        }
        else if (seConsulto && viajesFiltrados.Count == 0)
        {
            <DataStateBanner Title="@(viajesCargados.Count == 0 ? "No hay datos para el rango seleccionado." : "No hay viajes con los filtros seleccionados.")">
                <ChildContent>
                    <p class="vz-state-subtitle">@(viajesCargados.Count == 0 ? "Prueba ampliando el rango Desde/Hasta." : "Prueba limpiando algunos filtros.")</p>
                </ChildContent>
                <Actions>
                    @if (viajesCargados.Count > 0)
                    {
                        <button type="button" class="vz-btn vz-btn-secondary" @onclick="LimpiarTodosLosFiltros">Limpiar filtros</button>
                    }
                </Actions>
            </DataStateBanner>
        }
        else if (viajesFiltrados.Count > 0 && agruparPor == "jerarquia" && raizJerarquia is not null)
        {
            <div class="vz-arbol-controles">
                <button type="button" class="vz-btn" @onclick="() => arbolRef?.ExpandirTodo()">Expandir todo</button>
                <button type="button" class="vz-btn" @onclick="() => arbolRef?.ColapsarTodo()">Colapsar todo</button>
            </div>
            <ArbolJerarquiaViajes @ref="arbolRef"
                                  Raiz="raizJerarquia"
                                  Meses="mesesPivote"
                                  MostrarViajes="mostrarViajes"
                                  MostrarKms="mostrarKms"
                                  MostrarPeaje="mostrarPeaje"
                                  MostrarKmPorViaje="mostrarKmPorViaje"
                                  MostrarParticipacion="mostrarParticipacion"
                                  SoloComparativa="soloComparativa" />
        }
        else if (viajesFiltrados.Count > 0)
        {
            <TablaPivoteViajes Filas="filasPivote"
                               Meses="mesesPivote"
                               EtiquetaDimension="@EtiquetaAgrupacionActual"
                               EsDimensionTemporal="@(agruparPor is "dia" or "semana")"
                               MostrarViajes="mostrarViajes"
                               MostrarKms="mostrarKms"
                               MostrarPeaje="mostrarPeaje"
                               MostrarKmPorViaje="mostrarKmPorViaje"
                               MostrarParticipacion="mostrarParticipacion"
                               SoloComparativa="soloComparativa" />
        }

    }

</div>

@code {
    private bool mostrarResumen;

    private readonly ConsultaViajesFilterModel filtro = new();

    private List<ViajesDto> viajesCargados = [];
    private List<ViajesDto> viajesFiltrados = [];
    private bool isLoading;
    private bool seConsulto;
    private bool mostrarMasFiltros;
    private string? errorMessage;
    private string agruparPor = "matriz";

    private List<FiltroZemog> filtros = [];
    private FiltroZemog? filtroAbierto;

    private IEnumerable<FiltroZemog> FiltrosPrimarios => filtros.Take(5);
    private IEnumerable<FiltroZemog> FiltrosSecundarios => filtros.Skip(5);

    private CorteMensual? corte;
    private List<KpiComparativo> kpisComparativa = [];

    private bool mostrarViajes = true;
    private bool mostrarKms = true;
    private bool mostrarPeaje = true;
    private bool mostrarKmPorViaje = true;
    private bool mostrarParticipacion;
    private bool soloComparativa;

    private List<FilaPivote> filasPivote = [];
    private List<MesColumna> mesesPivote = [];
    private NodoJerarquia? raizJerarquia;
    private ArbolJerarquiaViajes? arbolRef;

    // Cliente/Zona: CamposDerivadosViajes.ObtenerCliente/ObtenerZona (Fase 4/§54.78-54.81).
    // Matriz: v._base. Sucursal: sin columna confirmada en el SP (§54.21) — se usa el mismo
    // valor de Matriz, replicando el fallback "su=r.suc||mt" de viajes_v14.html cuando el Excel
    // no trae Sucursal. En la práctica esa cadena Matriz→Sucursal siempre tiene 1 solo hijo, así
    // que el colapso de cadenas de hijo único (ArbolJerarquiaViajes.Caminar) la oculta sola —
    // ver Fase 7 / §54.109.
    private static readonly Func<ViajesDto, string?>[] NivelesJerarquia =
    [
        CamposDerivadosViajes.ObtenerCliente,
        CamposDerivadosViajes.ObtenerZona,
        v => v._base,
        v => v._base,
    ];

    private static readonly Dictionary<string, string> EtiquetasAgrupacion = new()
    {
        ["cliente"] = "Cliente",
        ["zona"] = "Zona",
        ["matriz"] = "Matriz",
        ["expedicion"] = "Expedición",
        ["operador"] = "Operador",
        ["unidad"] = "Unidad",
        ["ruta"] = "Ruta",
        ["destino"] = "Destino",
        ["movimiento"] = "Movimiento",
        ["semana"] = "Semana",
        ["dia"] = "Día",
    };

    private string EtiquetaAgrupacionActual => EtiquetasAgrupacion.GetValueOrDefault(agruparPor, "Dimensión");

    private sealed class FiltroZemog
    {
        public required string Clave { get; init; }
        public required string Etiqueta { get; init; }
        public required Func<ViajesDto, string?> Selector { get; init; }
        public bool Disponible { get; init; } = true;
        public string? MotivoPendiente { get; init; }
        public bool ConBuscador { get; init; }
        public HashSet<string> Seleccionados { get; set; } = [];
        public List<string> OpcionesDisponibles { get; set; } = [];
    }

    protected override void OnInitialized()
    {
        // Orden exacto de cascada de viajes_v14.html (KEYS_P.concat(KEYS_S)).
        // Destino/Movimiento pasan a FUNCIONAL en la Fase 4 (CamposDerivadosViajes.ParsearRuta).
        // Cliente/Zona pasan a FUNCIONAL tras la confirmación del usuario (2026-08-31) de que
        // tipo_operacion sí lo regresa el SP — ver §54.78 (CamposDerivadosViajes.ParsearClienteZona).
        // Sucursal/Edo.Destino/Tarifa siguen pendientes — ver §54.20/§54.21 y Fase 4 puntos 4 y 7.
        filtros =
        [
            new() { Clave = "cliente", Etiqueta = "Cliente", Selector = CamposDerivadosViajes.ObtenerCliente, ConBuscador = true },
            new() { Clave = "sucursal", Etiqueta = "Sucursal", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente de backend: granularidad más fina que Matriz (_base), sin confirmar — ver §54.21" },
            new() { Clave = "mes", Etiqueta = "Mes", Selector = CamposDerivadosViajes.ObtenerMesEtiqueta },
            new() { Clave = "destino", Etiqueta = "Destino", Selector = CamposDerivadosViajes.ObtenerDestino, ConBuscador = true },
            new() { Clave = "expedicion", Etiqueta = "Expedición", Selector = v => v.expedicion },
            new() { Clave = "zona", Etiqueta = "Zona", Selector = CamposDerivadosViajes.ObtenerZona, ConBuscador = true },
            new() { Clave = "matriz", Etiqueta = "Matriz", Selector = v => v._base },
            new() { Clave = "anio", Etiqueta = "Año", Selector = CamposDerivadosViajes.ObtenerAnio },
            new() { Clave = "semana", Etiqueta = "Semana", Selector = CamposDerivadosViajes.ObtenerSemana },
            new() { Clave = "edestino", Etiqueta = "Edo. Destino", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente: el código entre paréntesis de Ruta (CodigoDestino) no está confirmado como EstadoDestino — se dejan separados a propósito, ver Fase 4 punto 4" },
            new() { Clave = "operador", Etiqueta = "Operador", Selector = v => v.operador1, ConBuscador = true },
            new() { Clave = "unidad", Etiqueta = "Unidad", Selector = v => v.id_unidad, ConBuscador = true },
            new() { Clave = "tarifa", Etiqueta = "Tipo de tarifa", Selector = _ => null, Disponible = false,
                    MotivoPendiente = "Pendiente: tarifaDeRuta() del HTML asume un formato de Ruta distinto al confirmado — ver §54.20/Fase 4 punto 7" },
            new() { Clave = "movimiento", Etiqueta = "Movimiento", Selector = CamposDerivadosViajes.ObtenerMovimiento },
        ];
    }

    private void ToggleMasFiltros() => mostrarMasFiltros = !mostrarMasFiltros;

    private void ToggleFiltro(FiltroZemog f) => filtroAbierto = filtroAbierto == f ? null : f;

    private Task OnFiltroCambiadoAsync(FiltroZemog f, HashSet<string> nuevaSeleccion)
    {
        f.Seleccionados = nuevaSeleccion;
        RecalcularCascada(f.Clave);
        viajesFiltrados = ObtenerViajesFiltrados();
        CalcularKpis();
        RecalcularPivote();
        return Task.CompletedTask;
    }

    private void LimpiarTodosLosFiltros()
    {
        foreach (var f in filtros)
            f.Seleccionados.Clear();

        RecalcularCascada(null);
        viajesFiltrados = ObtenerViajesFiltrados();
        CalcularKpis();
        RecalcularPivote();
    }

    // TEMPORAL MVP: cascada calculada en memoria sobre viajesCargados (el resultado
    // ya traído por GetViajesQuery). FINAL: si el volumen de datos crece, mover el
    // cálculo de opciones disponibles a Application/SQL (ver §54.27).
    private void RecalcularCascada(string? claveModificada)
    {
        if (claveModificada is null)
        {
            foreach (var f in filtros.Where(f => f.Disponible))
            {
                f.OpcionesDisponibles = CalcularOpciones(viajesCargados, f);
                f.Seleccionados.IntersectWith(f.OpcionesDisponibles);
            }
            return;
        }

        var pasoElCambio = false;
        var filtrado = viajesCargados;

        foreach (var f in filtros)
        {
            if (f.Disponible && f.Seleccionados.Count > 0)
                filtrado = filtrado.Where(v => f.Selector(v) is { } val && f.Seleccionados.Contains(val)).ToList();

            if (f.Clave == claveModificada)
                pasoElCambio = true;

            if (pasoElCambio && f.Clave != claveModificada && f.Disponible)
            {
                f.OpcionesDisponibles = CalcularOpciones(filtrado, f);
                f.Seleccionados.IntersectWith(f.OpcionesDisponibles);
            }
        }
    }

    private static List<string> CalcularOpciones(IEnumerable<ViajesDto> datos, FiltroZemog f) =>
        datos.Select(f.Selector)
             .Where(v => !string.IsNullOrWhiteSpace(v))
             .Select(v => v!)
             .Distinct()
             .OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase)
             .ToList();

    private List<ViajesDto> ObtenerViajesFiltrados()
    {
        var resultado = viajesCargados;

        foreach (var f in filtros.Where(f => f.Disponible && f.Seleccionados.Count > 0))
            resultado = resultado.Where(v => f.Selector(v) is { } val && f.Seleccionados.Contains(val)).ToList();

        return resultado;
    }

    private string? ObtenerValorAgrupacion(ViajesDto v) => agruparPor switch
    {
        "cliente" => CamposDerivadosViajes.ObtenerCliente(v),
        "zona" => CamposDerivadosViajes.ObtenerZona(v),
        "matriz" => v._base,
        "expedicion" => v.expedicion,
        "operador" => v.operador1,
        "unidad" => v.id_unidad,
        "ruta" => v.ruta,
        "destino" => CamposDerivadosViajes.ObtenerDestino(v),
        "movimiento" => CamposDerivadosViajes.ObtenerMovimiento(v),
        "semana" => CamposDerivadosViajes.ObtenerSemana(v),
        "dia" => CamposDerivadosViajes.ObtenerFechaNegocio(v)?.ToString("dd MMM yyyy", Cultura),
        _ => null,
    };

    // TEMPORAL MVP: el pivote (y el árbol de jerarquía) se arman en memoria sobre
    // viajesFiltrados (el resultado ya traído por GetViajesQuery, ya reducido por los
    // filtros de la Fase 2). FINAL: si el volumen real lo justifica, mover esta
    // agregación a SQL/Application (agrupar por dimensión y mes directo en la query)
    // — ver §54.22-54.23/§54.27.
    private void RecalcularPivote()
    {
        if (agruparPor == "jerarquia")
        {
            RecalcularArbol();
            mesesPivote = CalcularMesesPivote();
            return;
        }

        var esTemporal = agruparPor is "dia" or "semana";

        var grupos = viajesFiltrados
            .Where(v => ObtenerValorAgrupacion(v) is not null)
            .GroupBy(v => ObtenerValorAgrupacion(v)!)
            .ToList();

        var filas = new List<FilaPivote>();

        foreach (var grupo in grupos)
        {
            var fila = new FilaPivote { Dimension = grupo.Key };

            if (esTemporal)
            {
                fila.Total = CalcularMetricas(grupo, corte);
            }
            else
            {
                foreach (var porMes in grupo.GroupBy(CamposDerivadosViajes.ObtenerMesClave))
                {
                    if (porMes.Key is null)
                        continue;

                    fila.PorMes[porMes.Key] = CalcularMetricas(porMes, corte);
                }

                fila.Total = fila.PorMes.Values.Aggregate(MetricasMes.Vacio, MetricasMes.Sumar);
            }

            filas.Add(fila);
        }

        filasPivote = filas;

        mesesPivote = esTemporal ? [] : CalcularMesesPivote();
    }

    private List<MesColumna> CalcularMesesPivote() =>
        viajesFiltrados
            .Select(v => (Clave: CamposDerivadosViajes.ObtenerMesClave(v), Etiqueta: CamposDerivadosViajes.ObtenerMesEtiqueta(v)))
            .Where(t => t.Clave is not null)
            .DistinctBy(t => t.Clave)
            .OrderBy(t => t.Clave)
            .Select(t => new MesColumna(t.Clave!, t.Etiqueta!))
            .ToList();

    // Replica la construcción del árbol de tablaJerarquia() en viajes_v14.html: cada viaje
    // acumula en la RAÍZ y en TODOS sus ancestros (Cliente, Cliente>Zona, ...), no solo en su
    // nodo hoja — así Raiz.PorMes/Total ya son el gran total de la tabla, sin cálculo aparte
    // (ver Testing/Features/JerarquiaViajesModels.cs). Reutiliza ContribucionViajeProyectada
    // (Fase 6): mismo criterio Ida-only y misma proyección del mes abierto que el pivote plano
    // y las tarjetas KPI — ver Fase 7 / §54.108.
    private void RecalcularArbol()
    {
        var anterior = raizJerarquia;
        var nuevo = new NodoJerarquia { Id = "", Label = "TOTAL", Nivel = -1 };

        foreach (var viaje in viajesFiltrados)
        {
            var fecha = CamposDerivadosViajes.ObtenerFechaNegocio(viaje);
            if (fecha is null)
                continue;

            var mesClave = fecha.Value.ToString("yyyy-MM");
            Acumular(nuevo, mesClave, viaje);

            var nodo = nuevo;
            foreach (var nivel in NivelesJerarquia)
            {
                var clave = nivel(viaje) is { Length: > 0 } valor ? valor : "(sin dato)";
                nodo = ObtenerOCrearHijo(nodo, clave);
                Acumular(nodo, mesClave, viaje);
            }
        }

        if (anterior is not null)
            PreservarExpansion(nuevo, anterior);

        raizJerarquia = nuevo;
    }

    private static NodoJerarquia ObtenerOCrearHijo(NodoJerarquia padre, string clave)
    {
        if (padre.Hijos.TryGetValue(clave, out var existente))
            return existente;

        var nuevoHijo = new NodoJerarquia
        {
            Id = $"{padre.Id}>{clave}",
            Label = clave,
            Nivel = padre.Nivel + 1,
            IsExpanded = padre.Nivel + 1 == 0,
        };
        padre.Hijos[clave] = nuevoHijo;
        return nuevoHijo;
    }

    private void Acumular(NodoJerarquia nodo, string mesClave, ViajesDto viaje)
    {
        var metrica = new MetricasMes(
            (int)Math.Round(ContribucionViajeProyectada.Viajes(viaje, corte)),
            ContribucionViajeProyectada.Kms(viaje, corte),
            ContribucionViajeProyectada.Peaje(viaje, corte));

        nodo.PorMes[mesClave] = MetricasMes.Sumar(nodo.ObtenerMes(mesClave), metrica);
        nodo.Total = MetricasMes.Sumar(nodo.Total, metrica);
    }

    // Conserva IsExpanded entre reconstrucciones del árbol (nuevos filtros/consulta) para que
    // el usuario no pierda lo que ya expandió — el HTML no lo necesita porque EXPAND vive
    // aparte del árbol; aquí IsExpanded vive en el nodo (ver JerarquiaViajesModels.cs), así que
    // hay que copiarlo explícitamente del árbol viejo al nuevo, emparejando por clave de nivel.
    private static void PreservarExpansion(NodoJerarquia nuevo, NodoJerarquia anterior)
    {
        foreach (var (clave, hijoNuevo) in nuevo.Hijos)
        {
            if (anterior.Hijos.TryGetValue(clave, out var hijoAnterior))
            {
                hijoNuevo.IsExpanded = hijoAnterior.IsExpanded;
                PreservarExpansion(hijoNuevo, hijoAnterior);
            }
        }
    }

    // Viajes cuenta solo tramos de Ida (ContribucionViajeProyectada.Viajes) y aplica el
    // factor de proyección del mes abierto por viaje, no por grupo — un grupo (ej. Semana)
    // puede mezclar viajes de más de un mes, cada uno con su propio factor. Ver Fase 6 /
    // §54.99 y CorteMensual.FactorPara(ViajesDto) en Testing.Application.
    private static MetricasMes CalcularMetricas(IEnumerable<ViajesDto> grupo, CorteMensual? corte)
    {
        var lista = grupo as IReadOnlyCollection<ViajesDto> ?? grupo.ToList();
        var viajes = lista.Sum(v => ContribucionViajeProyectada.Viajes(v, corte));
        var kms = lista.Sum(v => ContribucionViajeProyectada.Kms(v, corte));
        var peaje = lista.Sum(v => ContribucionViajeProyectada.Peaje(v, corte));
        return new MetricasMes((int)Math.Round(viajes), kms, peaje);
    }

    private async Task ConsultarAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var query = new GetViajesQuery(
                filtro.FechaInicio, filtro.FechaFin, filtro.TipoFecha,
                filtro.Areas, filtro.IdUnidad, filtro.Estados,
                filtro.IdRuta, filtro.IdOperador, filtro.NoRemision);

            var resultado = await Sender.Send(query);

            if (resultado.IsFailure)
            {
                errorMessage = resultado.Error.Message;
                viajesCargados = [];
            }
            else
            {
                viajesCargados = resultado.Value.ToList();
            }
        }
        catch (FluentValidation.ValidationException vex)
        {
            errorMessage = string.Join(" ", vex.Errors.Select(e => e.ErrorMessage));
            viajesCargados = [];
        }
        catch (Exception)
        {
            errorMessage = "Intenta nuevamente en unos segundos.";
            viajesCargados = [];
        }
        finally
        {
            isLoading = false;
            seConsulto = true;
            corte = CorteMensual.Calcular(viajesCargados);
            RecalcularCascada(null);
            viajesFiltrados = ObtenerViajesFiltrados();
            CalcularKpis();
            RecalcularPivote();
        }
    }

    private void CalcularKpis() => kpisComparativa = KpisComparativaCalculator.Calcular(viajesFiltrados, corte).ToList();

    private static string TituloKpi(KpiComparativo kpi) =>
        kpi.EtiquetaMesActual is null
            ? kpi.Etiqueta
            : $"{kpi.Etiqueta} · {kpi.EtiquetaMesActual}" + (kpi.EtiquetaMesAnterior is null ? "" : $" / {kpi.EtiquetaMesAnterior}");

    private string ValorKpi(KpiComparativo kpi) => kpi.Clave switch
    {
        "kms" or "kpv" or "viajes" => FormatoNumero(kpi.ValorActual ?? 0),
        _ => FormatoDinero(kpi.ValorActual ?? 0),
    };

    private string DeltaKpi(KpiComparativo kpi)
    {
        if (kpi.SinMesAnterior) return "sin mes anterior";
        if (kpi.SinBaseAnterior) return $"sin base en {kpi.EtiquetaMesAnterior}";

        var delta = kpi.DeltaPorcentaje;
        if (delta is null) return "";

        var signo = delta > 0 ? "▲ +" : delta < 0 ? "▼ " : "";
        return $"{signo}{delta.Value.ToString("0.0", Cultura)}%";
    }

    private static Variant VarianteKpi(KpiComparativo kpi) => kpi.DeltaPorcentaje switch
    {
        > 0 => Variant.Success,
        < 0 => Variant.Danger,
        _ => Variant.Neutral,
    };

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");

    private static string FormatoNumero(decimal v) => Math.Round(v).ToString("N0", Cultura);
    private static string FormatoDinero(decimal v) => v.ToString("C0", Cultura);

    private string TextoCorte()
    {
        if (!seConsulto)
            return $"Rango a consultar: {filtro.FechaInicio.ToString("dd MMM yyyy", Cultura)} – {filtro.FechaFin.ToString("dd MMM yyyy", Cultura)}";

        if (viajesCargados.Count == 0)
            return "Sin viajes en el rango consultado";

        if (corte is null)
            return $"Sin fecha reconocible · {viajesCargados.Count} viajes cargados en el rango consultado";

        var fechaCorte = new DateTime(corte.Anio, corte.Mes, corte.DiaCorte);
        var proyeccion = corte.Factor != 1m
            ? $" · proyectando {fechaCorte.ToString("MMM yyyy", Cultura)} ×{corte.Factor.ToString("0.00", Cultura)}"
            : "";

        return $"Corte: {fechaCorte.ToString("dd MMM yyyy", Cultura)}{proyeccion} · {viajesCargados.Count} viajes cargados en el rango consultado";
    }
}