@using System.Globalization
@using Testing.Application.GetAllViajes

<section class="re-bloque re-nivel">
    <h3>@Titulo</h3>

    @if (Bloque.MesAnterior is not null)
    {
        <h4>Comparativo vs mes anterior</h4>
        <div class="re-tbl-wrap">
            <table class="re-tabla">
                <thead>
                    <tr><th>Métrica</th><th>@Bloque.MesAnterior.Value.Etiqueta</th><th>@Bloque.MesUltimo.Etiqueta</th><th>Δ</th><th>%</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Viajes</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesAnterior!.Viajes)</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesUltimo.Viajes)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaViajesPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Viajes - Bloque.TotalesAnterior.Viajes, FormatoUi.Numero)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaViajesPctVsAnterior)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaViajesPctVsAnterior)</td>
                    </tr>
                    <tr>
                        <td>KM</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesAnterior.Kms)</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesUltimo.Kms)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaKmsPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Kms - Bloque.TotalesAnterior.Kms, FormatoUi.Numero)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaKmsPctVsAnterior)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaKmsPctVsAnterior)</td>
                    </tr>
                    <tr>
                        <td>Venta</td>
                        <td class="align-end tabular">@FormatoUi.Dinero(Bloque.TotalesAnterior.Venta)</td>
                        <td class="align-end tabular">@FormatoUi.Dinero(Bloque.TotalesUltimo.Venta)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaVentaPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Venta - Bloque.TotalesAnterior.Venta, FormatoUi.Dinero)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaVentaPctVsAnterior)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaVentaPctVsAnterior)</td>
                    </tr>
                    <tr>
                        <td>$/KM</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesAnterior.PorKm)</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesUltimo.PorKm)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaPkmPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.PorKm - Bloque.TotalesAnterior.PorKm, FormatoPkm)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaPkmPctVsAnterior)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaPkmPctVsAnterior)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (Bloque.HayComparativoVsEnero)
    {
        <h4>Comparativo vs @Bloque.PrimerMesDelAnio.Etiqueta (avance del año)</h4>
        <div class="re-tbl-wrap">
            <table class="re-tabla">
                <thead>
                    <tr><th>Métrica</th><th>@Bloque.PrimerMesDelAnio.Etiqueta</th><th>@Bloque.MesUltimo.Etiqueta</th><th>Δ</th><th>%</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Viajes</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesPrimerMesDelAnio.Viajes)</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesUltimo.Viajes)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaViajesPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Viajes - Bloque.TotalesPrimerMesDelAnio.Viajes, FormatoUi.Numero)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaViajesPctVsEnero)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaViajesPctVsEnero)</td>
                    </tr>
                    <tr>
                        <td>KM</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesPrimerMesDelAnio.Kms)</td>
                        <td class="align-end tabular">@FormatoUi.Numero(Bloque.TotalesUltimo.Kms)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaKmsPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Kms - Bloque.TotalesPrimerMesDelAnio.Kms, FormatoUi.Numero)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaKmsPctVsEnero)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaKmsPctVsEnero)</td>
                    </tr>
                    <tr>
                        <td>Venta</td>
                        <td class="align-end tabular">@FormatoUi.Dinero(Bloque.TotalesPrimerMesDelAnio.Venta)</td>
                        <td class="align-end tabular">@FormatoUi.Dinero(Bloque.TotalesUltimo.Venta)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaVentaPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Venta - Bloque.TotalesPrimerMesDelAnio.Venta, FormatoUi.Dinero)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaVentaPctVsEnero)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaVentaPctVsEnero)</td>
                    </tr>
                    <tr>
                        <td>$/KM</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesPrimerMesDelAnio.PorKm)</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesUltimo.PorKm)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaPkmPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.PorKm - Bloque.TotalesPrimerMesDelAnio.PorKm, FormatoPkm)</td>
                        <td class="align-end tabular @FormatoUi.ClaseDeltaResumen(Bloque.DeltaPkmPctVsEnero)">@FormatoUi.DeltaPorcentaje(Bloque.DeltaPkmPctVsEnero)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <h4>Tendencia mensual</h4>
    <div class="re-tbl-wrap">
        <table class="re-tabla">
            <thead><tr><th>Mes</th><th>Viajes</th><th>KM</th><th>Venta</th><th>$/KM</th></tr></thead>
            <tbody>
                @foreach (var (mes, totales) in Bloque.Tendencia)
                {
                    <tr class="@(EsPeorMes(mes) ? "re-peor" : EsMejorMes(mes) ? "re-mejor" : "")">
                        <td>@mes.Etiqueta</td>
                        <td class="align-end tabular">@FormatoUi.Numero(totales.Viajes)</td>
                        <td class="align-end tabular">@FormatoUi.Numero(totales.Kms)</td>
                        <td class="align-end tabular">@FormatoUi.Dinero(totales.Venta)</td>
                        <td class="align-end tabular">@FormatoUi.Dinero(totales.PorKm)</td>
                    </tr>
                }
                <tr class="re-total">
                    <td>TOTAL</td>
                    <td class="align-end tabular">@FormatoUi.Numero(TotalTendencia().Viajes)</td>
                    <td class="align-end tabular">@FormatoUi.Numero(TotalTendencia().Kms)</td>
                    <td class="align-end tabular">@FormatoUi.Dinero(TotalTendencia().Venta)</td>
                    <td class="align-end tabular">@FormatoUi.Dinero(TotalTendencia().PorKm)</td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (Bloque.PeorMesDelAnio is not null)
    {
        <p class="re-nota">Peor mes (por venta): <b>@Bloque.PeorMesDelAnio.Value.Mes.Etiqueta</b> (@FormatoUi.Dinero(Bloque.PeorMesDelAnio.Value.Venta)). Mejor mes: <b>@Bloque.MejorMesDelAnio!.Value.Mes.Etiqueta</b> (@FormatoUi.Dinero(Bloque.MejorMesDelAnio.Value.Venta)).</p>
    }

    @if (Bloque.Tendencia.Count > 0)
    {
        <div class="re-graficas-fila">
            <GraficaTendencia Titulo="Venta mensual" NombreSerieReal="Venta" Datos="ventaPorMes" />
            <GraficaTendencia Titulo="$/KM mensual" NombreSerieReal="$/KM" EsDinero="false" Datos="pkmPorMes" />
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public BloqueNivelDto Bloque { get; set; } = null!;

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");
    private List<(string Etiqueta, decimal Valor)> ventaPorMes = [];
    private List<(string Etiqueta, decimal Valor)> pkmPorMes = [];

    protected override void OnParametersSet()
    {
        ventaPorMes = Bloque.Tendencia.Select(t => (t.Mes.Etiqueta, t.Totales.Venta)).ToList();
        pkmPorMes = Bloque.Tendencia.Select(t => (t.Mes.Etiqueta, t.Totales.PorKm)).ToList();
    }

    private static string FormatoPkm(decimal v) => "$" + v.ToString("0.00", Cultura);

    private static string FormatoDeltaAbs(decimal delta, Func<decimal, string> formato) => (delta >= 0 ? "+" : "-") + formato(Math.Abs(delta));

    private bool EsPeorMes(MesCerrado mes) => Bloque.PeorMesDelAnio?.Mes == mes;
    private bool EsMejorMes(MesCerrado mes) => Bloque.MejorMesDelAnio?.Mes == mes;
    private TotalesPeriodo TotalTendencia() => Bloque.Tendencia.Select(t => t.Totales).Aggregate(TotalesPeriodo.Vacio, TotalesPeriodo.Sumar);
}