@using System.Globalization
@using Testing.Application.GetAllViajes

<section class="re-bloque re-nivel">
    <h3>@Titulo</h3>

    @if (Bloque.MesAnterior is not null)
    {
        <h4>Comparativo vs mes anterior</h4>
        <div class="re-tbl-wrap">
            <table class="re-tabla">
                <thead>
                    <tr><th>Métrica</th><th>@Bloque.MesAnterior.Value.Etiqueta</th><th>@Bloque.MesUltimo.Etiqueta</th><th>Δ</th><th>%</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Viajes</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesAnterior!.Viajes)</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesUltimo.Viajes)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaViajesPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Viajes - Bloque.TotalesAnterior.Viajes, FormatoNumero)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaViajesPctVsAnterior)">@FormatoDeltaPct(Bloque.DeltaViajesPctVsAnterior)</td>
                    </tr>
                    <tr>
                        <td>KM</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesAnterior.Kms)</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesUltimo.Kms)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaKmsPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Kms - Bloque.TotalesAnterior.Kms, FormatoNumero)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaKmsPctVsAnterior)">@FormatoDeltaPct(Bloque.DeltaKmsPctVsAnterior)</td>
                    </tr>
                    <tr>
                        <td>Venta</td>
                        <td class="align-end tabular">@FormatoDinero(Bloque.TotalesAnterior.Venta)</td>
                        <td class="align-end tabular">@FormatoDinero(Bloque.TotalesUltimo.Venta)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaVentaPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Venta - Bloque.TotalesAnterior.Venta, FormatoDinero)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaVentaPctVsAnterior)">@FormatoDeltaPct(Bloque.DeltaVentaPctVsAnterior)</td>
                    </tr>
                    <tr>
                        <td>$/KM</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesAnterior.PorKm)</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesUltimo.PorKm)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaPkmPctVsAnterior)">@FormatoDeltaAbs(Bloque.TotalesUltimo.PorKm - Bloque.TotalesAnterior.PorKm, FormatoPkm)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaPkmPctVsAnterior)">@FormatoDeltaPct(Bloque.DeltaPkmPctVsAnterior)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @if (Bloque.HayComparativoVsEnero)
    {
        <h4>Comparativo vs @Bloque.PrimerMesDelAnio.Etiqueta (avance del año)</h4>
        <div class="re-tbl-wrap">
            <table class="re-tabla">
                <thead>
                    <tr><th>Métrica</th><th>@Bloque.PrimerMesDelAnio.Etiqueta</th><th>@Bloque.MesUltimo.Etiqueta</th><th>Δ</th><th>%</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Viajes</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesPrimerMesDelAnio.Viajes)</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesUltimo.Viajes)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaViajesPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Viajes - Bloque.TotalesPrimerMesDelAnio.Viajes, FormatoNumero)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaViajesPctVsEnero)">@FormatoDeltaPct(Bloque.DeltaViajesPctVsEnero)</td>
                    </tr>
                    <tr>
                        <td>KM</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesPrimerMesDelAnio.Kms)</td>
                        <td class="align-end tabular">@FormatoNumero(Bloque.TotalesUltimo.Kms)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaKmsPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Kms - Bloque.TotalesPrimerMesDelAnio.Kms, FormatoNumero)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaKmsPctVsEnero)">@FormatoDeltaPct(Bloque.DeltaKmsPctVsEnero)</td>
                    </tr>
                    <tr>
                        <td>Venta</td>
                        <td class="align-end tabular">@FormatoDinero(Bloque.TotalesPrimerMesDelAnio.Venta)</td>
                        <td class="align-end tabular">@FormatoDinero(Bloque.TotalesUltimo.Venta)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaVentaPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.Venta - Bloque.TotalesPrimerMesDelAnio.Venta, FormatoDinero)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaVentaPctVsEnero)">@FormatoDeltaPct(Bloque.DeltaVentaPctVsEnero)</td>
                    </tr>
                    <tr>
                        <td>$/KM</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesPrimerMesDelAnio.PorKm)</td>
                        <td class="align-end tabular">@FormatoPkm(Bloque.TotalesUltimo.PorKm)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaPkmPctVsEnero)">@FormatoDeltaAbs(Bloque.TotalesUltimo.PorKm - Bloque.TotalesPrimerMesDelAnio.PorKm, FormatoPkm)</td>
                        <td class="align-end tabular @ClaseDelta(Bloque.DeltaPkmPctVsEnero)">@FormatoDeltaPct(Bloque.DeltaPkmPctVsEnero)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <h4>Tendencia mensual</h4>
    <div class="re-tbl-wrap">
        <table class="re-tabla">
            <thead><tr><th>Mes</th><th>Viajes</th><th>KM</th><th>Venta</th><th>$/KM</th></tr></thead>
            <tbody>
                @foreach (var (mes, totales) in Bloque.Tendencia)
                {
                    <tr class="@(EsPeorMes(mes) ? "re-peor" : EsMejorMes(mes) ? "re-mejor" : "")">
                        <td>@mes.Etiqueta</td>
                        <td class="align-end tabular">@FormatoNumero(totales.Viajes)</td>
                        <td class="align-end tabular">@FormatoNumero(totales.Kms)</td>
                        <td class="align-end tabular">@FormatoDinero(totales.Venta)</td>
                        <td class="align-end tabular">@FormatoDinero(totales.PorKm)</td>
                    </tr>
                }
                <tr class="re-total">
                    <td>TOTAL</td>
                    <td class="align-end tabular">@FormatoNumero(TotalTendencia().Viajes)</td>
                    <td class="align-end tabular">@FormatoNumero(TotalTendencia().Kms)</td>
                    <td class="align-end tabular">@FormatoDinero(TotalTendencia().Venta)</td>
                    <td class="align-end tabular">@FormatoDinero(TotalTendencia().PorKm)</td>
                </tr>
            </tbody>
        </table>
    </div>
    @if (Bloque.PeorMesDelAnio is not null)
    {
        <p class="re-nota">Peor mes (por venta): <b>@Bloque.PeorMesDelAnio.Value.Mes.Etiqueta</b> (@FormatoDinero(Bloque.PeorMesDelAnio.Value.Venta)). Mejor mes: <b>@Bloque.MejorMesDelAnio!.Value.Mes.Etiqueta</b> (@FormatoDinero(Bloque.MejorMesDelAnio.Value.Venta)).</p>
    }

    @if (Bloque.Tendencia.Count > 0)
    {
        <div class="re-graficas-fila">
            <GraficaTendencia Titulo="Venta mensual" NombreSerieReal="Venta" Datos="Bloque.Tendencia.Select(t => (t.Mes.Etiqueta, t.Totales.Venta)).ToList()" />
            <GraficaTendencia Titulo="$/KM mensual" NombreSerieReal="$/KM" Datos="Bloque.Tendencia.Select(t => (t.Mes.Etiqueta, t.Totales.PorKm)).ToList()" />
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public BloqueNivelDto Bloque { get; set; } = null!;

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");

    private static string FormatoNumero(decimal v) => Math.Round(v).ToString("N0", Cultura);
    private static string FormatoDinero(decimal v) => v.ToString("C0", Cultura);

    private static string FormatoPkm(decimal v) => "$" + v.ToString("0.00", Cultura);

    private static string FormatoDeltaAbs(decimal delta, Func<decimal, string> formato) => (delta >= 0 ? "+" : "-") + formato(Math.Abs(delta));

    private static string FormatoDeltaPct(decimal? v) => v is null ? "—" : ResumenEjecutivoCalculator.FormatoPorcentaje(v.Value);

    private static string ClaseDelta(decimal? v) => v switch
    {
        null => "re-neutro",
        > 0 => "re-pos",
        < 0 => "re-neg",
        _ => "re-neutro",
    };

    private bool EsPeorMes(MesCerrado mes) => Bloque.PeorMesDelAnio?.Mes == mes;
    private bool EsMejorMes(MesCerrado mes) => Bloque.MejorMesDelAnio?.Mes == mes;
    private TotalesPeriodo TotalTendencia() => Bloque.Tendencia.Select(t => t.Totales).Aggregate(TotalesPeriodo.Vacio, TotalesPeriodo.Sumar);
}