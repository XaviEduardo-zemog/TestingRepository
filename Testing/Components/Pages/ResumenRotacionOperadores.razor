@using System.Globalization
@using Testing.Application.GetAllViajes

<section class="re-bloque re-rotacion">
    <h3>Rotación de operadores</h3>

    @if (Rotacion.PorSucursal.Count == 0)
    {
        <p class="re-vacio">Sin datos suficientes (se necesitan al menos 2 meses cerrados).</p>
    }
    else
    {
        <div class="re-tbl-wrap">
            <table class="re-tabla">
                <thead>
                    <tr>
                        <th class="re-th-dim @ClaseOrden("sucursal")" @onclick='() => OrdenarPor("sucursal")'>Sucursal @Flecha("sucursal")</th>
                        <th class="@ClaseOrden("activos")" @onclick='() => OrdenarPor("activos")'>Activos @MesUltimo @Flecha("activos")</th>
                        <th class="@ClaseOrden("altas")" @onclick='() => OrdenarPor("altas")'>Altas en el año @Flecha("altas")</th>
                        <th class="@ClaseOrden("bajas")" @onclick='() => OrdenarPor("bajas")'>Dejaron de aparecer @Flecha("bajas")</th>
                        <th class="@ClaseOrden("viajesAnt")" @onclick='() => OrdenarPor("viajesAnt")'>Viajes @MesAnterior @Flecha("viajesAnt")</th>
                        <th class="@ClaseOrden("viajesAct")" @onclick='() => OrdenarPor("viajesAct")'>Viajes @MesUltimo @Flecha("viajesAct")</th>
                        <th class="@ClaseOrden("pct")" @onclick='() => OrdenarPor("pct")'>% Viajes @Flecha("pct")</th>
                        <th class="@ClaseOrden("lectura")" @onclick='() => OrdenarPor("lectura")'>Lectura @Flecha("lectura")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in FilasOrdenadas())
                    {
                        <tr>
                            <td>@f.Sucursal</td>
                            <td class="align-end tabular">@f.Activos</td>
                            <td class="align-end tabular">@f.Altas</td>
                            <td class="align-end tabular">@f.Bajas</td>
                            <td class="align-end tabular">@FormatoNumero(f.ViajesAnterior)</td>
                            <td class="align-end tabular">@FormatoNumero(f.ViajesActual)</td>
                            <td class="align-end tabular @ClaseDelta(f.DeltaViajesPorcentaje)">@FormatoDeltaPct(f.DeltaViajesPorcentaje)</td>
                            <td class="@ClaseLectura(f.Lectura)">@f.Lectura</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="re-total">
                        <td>@Rotacion.Total.Sucursal</td>
                        <td class="align-end tabular">@Rotacion.Total.Activos</td>
                        <td class="align-end tabular">@Rotacion.Total.Altas</td>
                        <td class="align-end tabular">@Rotacion.Total.Bajas</td>
                        <td class="align-end tabular">@FormatoNumero(Rotacion.Total.ViajesAnterior)</td>
                        <td class="align-end tabular">@FormatoNumero(Rotacion.Total.ViajesActual)</td>
                        <td class="align-end tabular @ClaseDelta(Rotacion.Total.DeltaViajesPorcentaje)">@FormatoDeltaPct(Rotacion.Total.DeltaViajesPorcentaje)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    <p class="re-nota">"Activos" y "Altas en el año" en @MesUltimo no son mutuamente excluyentes: un operador nuevo que ya trabajó este mes cuenta en ambas columnas (mismo criterio que viajes_v14.html). La celda "Lectura" del TOTAL queda vacía, igual que RE_seccionRotacion.</p>
</section>

@code {
    [Parameter, EditorRequired] public RotacionOperadoresDto Rotacion { get; set; } = null!;
    [Parameter] public string? MesUltimo { get; set; }
    [Parameter] public string? MesAnterior { get; set; }

    private string ordenClave = "bajas";
    private bool ordenDescendente = true;

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");

    private void OrdenarPor(string clave)
    {
        if (ordenClave == clave) ordenDescendente = !ordenDescendente;
        else { ordenClave = clave; ordenDescendente = clave != "sucursal" && clave != "lectura"; }
    }

    private string ClaseOrden(string clave) => ordenClave == clave ? "re-th-ord is-active" : "re-th-ord";

    private string Flecha(string clave) => ordenClave == clave ? (ordenDescendente ? " ▼" : " ▲") : "";

    private List<RotacionSucursalDto> FilasOrdenadas()
    {
        IOrderedEnumerable<RotacionSucursalDto> query = ordenClave switch
        {
            "activos" => Rotacion.PorSucursal.OrderBy(f => f.Activos),
            "altas" => Rotacion.PorSucursal.OrderBy(f => f.Altas),
            "bajas" => Rotacion.PorSucursal.OrderBy(f => f.Bajas),
            "viajesAnt" => Rotacion.PorSucursal.OrderBy(f => f.ViajesAnterior),
            "viajesAct" => Rotacion.PorSucursal.OrderBy(f => f.ViajesActual),
            "pct" => Rotacion.PorSucursal.OrderBy(f => f.DeltaViajesPorcentaje ?? decimal.MinValue),
            "lectura" => Rotacion.PorSucursal.OrderBy(f => f.Lectura, StringComparer.CurrentCultureIgnoreCase),
            _ => Rotacion.PorSucursal.OrderBy(f => f.Sucursal, StringComparer.CurrentCultureIgnoreCase),
        };

        return (ordenDescendente ? query.Reverse() : query).ToList();
    }

    private static string FormatoNumero(decimal v) => Math.Round(v).ToString("N0", Cultura);

    private static string FormatoDeltaPct(decimal? v) => v is null ? "—" : ResumenEjecutivoCalculator.FormatoPorcentaje(v.Value);

    private static string ClaseDelta(decimal? v) => v switch
    {
        null => "re-neutro",
        > 0 => "re-pos",
        < 0 => "re-neg",
        _ => "re-neutro",
    };

    private static string ClaseLectura(string lectura) => lectura switch
    {
        "Sin bajas" => "re-pos",
        "Volumen sostenido" => "re-neutro",
        _ => "re-neg",
    };
}