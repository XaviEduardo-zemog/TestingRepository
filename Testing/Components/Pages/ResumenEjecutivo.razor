@using Testing.Application.GetAllViajes
@inject IJSRuntime JS

<div class="re-page">
    <div class="re-toolbar">
        <div class="re-toolbar-texto">
            <h2>Resumen Ejecutivo</h2>
            <p class="re-subtitle">@Subtitulo()</p>
        </div>
        @if (resumen?.NivelZemog is not null)
        {
            <div class="re-toolbar-acciones">
                <button type="button" class="vz-btn vz-btn-primary" @onclick="AbrirPresentacionAsync">▶ Presentación</button>
                <button type="button" class="vz-btn vz-btn-secondary" @onclick="ExportarWordAsync">⬇ Exportar Word</button>
            </div>
        }
    </div>

    @if (resumen is null)
    {
        <p class="re-vacio">Sin datos cargados.</p>
    }
    else if (resumen.MesesCerrados.Count == 0)
    {
        <p class="re-vacio">No hay meses con datos en el rango consultado.</p>
    }
    else
    {
        <ResumenSemaforo Alertas="resumen.Semaforo" />

        @if (resumen.NivelZemog is not null)
        {
            <ResumenBloqueNivel Titulo="Zemog · Nivel general" Bloque="resumen.NivelZemog" />
        }

        @if (resumen.PorCliente.Count > 0)
        {
            <ResumenPorCliente PorCliente="resumen.PorCliente" />
        }

        @if (resumen.ArbolComparativo is not null)
        {
            <ResumenArbolComparativo Raiz="resumen.ArbolComparativo" MesUltimo="@MesUltimoEtiqueta()" MesAnterior="@MesAnteriorEtiqueta()" ArmadosDesconocidos="resumen.ArmadosDesconocidos" />
        }

        <ResumenDestinosCayendo Datos="resumen.DestinosCayendo" MesUltimo="@MesUltimoEtiqueta()" MesAnterior="@MesAnteriorEtiqueta()" />

        <ResumenAgenciasDesaparecidas Agencias="resumen.AgenciasDesaparecidas" MesUltimo="@MesUltimoEtiqueta()" />

        <ResumenOperadores Datos="resumen.Operadores" />

        <ResumenRotacionOperadores Rotacion="resumen.Rotacion" MesUltimo="@MesUltimoEtiqueta()" MesAnterior="@MesAnteriorEtiqueta()" />
    }

    <ResumenPresentacion @ref="presentacionRef" Viajes="Viajes" Corte="Corte" />
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ViajesDto> Viajes { get; set; } = [];
    [Parameter] public CorteMensual? Corte { get; set; }

    private ResumenEjecutivoDto? resumen;
    private ResumenPresentacion? presentacionRef;

    // Recalcula SIEMPRE que cambien los parámetros — a diferencia de la vista principal, el
    // Resumen Ejecutivo no reacciona a los 14 filtros (usa Viajes = viajesCargados completo,
    // nunca viajesFiltrados — mismo comportamiento que RE_render(), que nunca llama a getFilt()).
    // Ya NO excluye el mes de corte/avance (ver ResumenEjecutivoCalculator) -- esa regla es
    // exclusiva de Presentación (ver ResumenPresentacion.razor).
    protected override void OnParametersSet() => resumen = ResumenEjecutivoCalculator.Calcular(Viajes, Corte);

    private string? MesUltimoEtiqueta() => resumen is { MesesCerrados.Count: > 0 } ? resumen.MesesCerrados[^1].Etiqueta : null;

    private string? MesAnteriorEtiqueta() => resumen is { MesesCerrados.Count: >= 2 } ? resumen.MesesCerrados[^2].Etiqueta : null;

    private string Subtitulo()
    {
        if (resumen is null || resumen.MesesCerrados.Count == 0)
            return "Sin datos disponibles";

        return resumen.MesesCerrados.Count == 1
            ? $"Mes: {resumen.MesesCerrados[0].Etiqueta}"
            : $"Meses: {resumen.MesesCerrados[0].Etiqueta} – {resumen.MesesCerrados[^1].Etiqueta}";
    }

    private Task AbrirPresentacionAsync() => presentacionRef?.AbrirAsync() ?? Task.CompletedTask;

    // Genera el Word 100% en el servidor (reutiliza "resumen", ya cargado -- sin query nueva) y
    // lo entrega al navegador con el único JS interop de descarga del proyecto.
    private async Task ExportarWordAsync()
    {
        if (resumen is null) return;

        var html = ResumenEjecutivoWordExporter.Generar(resumen);
        // BOM inicial (U+FEFF) -- ayuda a Word a reconocer la codificación UTF-8 del HTML-como-.doc al abrirlo.
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes("\uFEFF" + html));
        var nombre = $"Resumen_Ejecutivo_Zemog_{DateTime.Now:yyyyMMdd}.doc";

        await JS.InvokeVoidAsync("vzInterop.descargarArchivo", nombre, "application/msword", base64);
    }
}