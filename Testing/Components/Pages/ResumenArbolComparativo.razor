@using System.Globalization
@using Testing.Application.GetAllViajes

<section class="re-bloque re-arbol-comparativo">
    <h3>Por Cliente › Zona › Matriz</h3>

    <div class="re-tbl-wrap">
        <table class="re-tabla">
            <thead>
                <tr>
                    <th class="re-th-dim @ClaseOrdenComp("label")" @onclick='() => OrdenarCompPor("label")'>Nivel @FlechaComp("label")</th>
                    <th class="@ClaseOrdenComp("viajesUlt")" @onclick='() => OrdenarCompPor("viajesUlt")'>Viajes @MesUltimo @FlechaComp("viajesUlt")</th>
                    <th class="@ClaseOrdenComp("deltaViajes")" @onclick='() => OrdenarCompPor("deltaViajes")'>%@FlechaComp("deltaViajes")</th>
                    <th class="@ClaseOrdenComp("kmUlt")" @onclick='() => OrdenarCompPor("kmUlt")'>KM @MesUltimo @FlechaComp("kmUlt")</th>
                    <th class="@ClaseOrdenComp("deltaKm")" @onclick='() => OrdenarCompPor("deltaKm")'>%@FlechaComp("deltaKm")</th>
                    <th class="@ClaseOrdenComp("ventaUlt")" @onclick='() => OrdenarCompPor("ventaUlt")'>Venta @MesUltimo @FlechaComp("ventaUlt")</th>
                    <th class="@ClaseOrdenComp("deltaVenta")" @onclick='() => OrdenarCompPor("deltaVenta")'>%@FlechaComp("deltaVenta")</th>
                    <th class="@ClaseOrdenComp("viajesAnio")" @onclick='() => OrdenarCompPor("viajesAnio")'>Viajes año @FlechaComp("viajesAnio")</th>
                    <th class="@ClaseOrdenComp("kmAnio")" @onclick='() => OrdenarCompPor("kmAnio")'>KM año @FlechaComp("kmAnio")</th>
                    <th class="@ClaseOrdenComp("ventaAnio")" @onclick='() => OrdenarCompPor("ventaAnio")'>Venta año @FlechaComp("ventaAnio")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Aplanar(CompararComp))
                {
                    var deltaViajes = Delta(fila.Nodo.Anterior.Viajes, fila.Nodo.Ultimo.Viajes);
                    var deltaKm = Delta(fila.Nodo.Anterior.Kms, fila.Nodo.Ultimo.Kms);
                    var deltaVenta = Delta(fila.Nodo.Anterior.Venta, fila.Nodo.Ultimo.Venta);
                    <tr>
                        <td class="re-th-dim" style="padding-left:@(8 + fila.Nivel * 14)px;">
                            @if (!fila.EsHoja)
                            {
                                <span class="re-flecha" @onclick="() => Alternar(fila.NodoOriginal)">@(fila.NodoOriginal.IsExpanded ? "▾" : "▸")</span>
                            }
                            else
                            {
                                <span class="re-flecha-vacia"></span>
                            }
                            @fila.Label
                        </td>
                        <td class="align-end tabular">@FormatoNumero(fila.Nodo.Ultimo.Viajes)</td>
                        <td class="align-end tabular @ClaseDelta(deltaViajes)">@FormatoPct(deltaViajes)</td>
                        <td class="align-end tabular">@FormatoNumero(fila.Nodo.Ultimo.Kms)</td>
                        <td class="align-end tabular @ClaseDelta(deltaKm)">@FormatoPct(deltaKm)</td>
                        <td class="align-end tabular">@FormatoDinero(fila.Nodo.Ultimo.Venta)</td>
                        <td class="align-end tabular @ClaseDelta(deltaVenta)">@FormatoPct(deltaVenta)</td>
                        <td class="align-end tabular">@FormatoNumero(fila.Nodo.Anual.Viajes)</td>
                        <td class="align-end tabular">@FormatoNumero(fila.Nodo.Anual.Kms)</td>
                        <td class="align-end tabular">@FormatoDinero(fila.Nodo.Anual.Venta)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @{
                    var deltaViajesTot = Delta(Raiz.Anterior.Viajes, Raiz.Ultimo.Viajes);
                    var deltaKmTot = Delta(Raiz.Anterior.Kms, Raiz.Ultimo.Kms);
                    var deltaVentaTot = Delta(Raiz.Anterior.Venta, Raiz.Ultimo.Venta);
                }
                <tr class="re-total">
                    <td>TOTAL</td>
                    <td class="align-end tabular">@FormatoNumero(Raiz.Ultimo.Viajes)</td>
                    <td class="align-end tabular @ClaseDelta(deltaViajesTot)">@FormatoPct(deltaViajesTot)</td>
                    <td class="align-end tabular">@FormatoNumero(Raiz.Ultimo.Kms)</td>
                    <td class="align-end tabular @ClaseDelta(deltaKmTot)">@FormatoPct(deltaKmTot)</td>
                    <td class="align-end tabular">@FormatoDinero(Raiz.Ultimo.Venta)</td>
                    <td class="align-end tabular @ClaseDelta(deltaVentaTot)">@FormatoPct(deltaVentaTot)</td>
                    <td class="align-end tabular">@FormatoNumero(Raiz.Anual.Viajes)</td>
                    <td class="align-end tabular">@FormatoNumero(Raiz.Anual.Kms)</td>
                    <td class="align-end tabular">@FormatoDinero(Raiz.Anual.Venta)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</section>

<section class="re-bloque re-asignacion">
    <h3>Asignación · Comodato / Full / Sencillo</h3>

    <div class="re-tbl-wrap">
        <table class="re-tabla">
            <thead>
                <tr>
                    <th class="re-th-dim @ClaseOrdenAsig("label")" @onclick='() => OrdenarAsigPor("label")'>Nivel @FlechaAsig("label")</th>
                    <th title="Pendiente fuente de Comodato -- no ordenable mientras esta columna siempre muestre &quot;—&quot;">Comodato</th>
                    <th class="@ClaseOrdenAsig("full")" @onclick='() => OrdenarAsigPor("full")'>Full @FlechaAsig("full")</th>
                    <th class="@ClaseOrdenAsig("sencillo")" @onclick='() => OrdenarAsigPor("sencillo")'>Sencillo @FlechaAsig("sencillo")</th>
                    <th class="@ClaseOrdenAsig("total")" @onclick='() => OrdenarAsigPor("total")'>Total viajes @FlechaAsig("total")</th>
                    <th title="Pendiente fuente de Comodato -- no ordenable mientras esta columna siempre muestre &quot;—&quot;">% Comodato</th>
                    <th>Δ pp vs @MesAnterior</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in FilasAsignacion())
                {
                    <tr>
                        <td class="re-th-dim" style="padding-left:@(8 + fila.Nivel * 14)px;">
                            @if (!fila.EsHoja)
                            {
                                <span class="re-flecha" @onclick="() => Alternar(fila.NodoOriginal)">@(fila.NodoOriginal.IsExpanded ? "▾" : "▸")</span>
                            }
                            else
                            {
                                <span class="re-flecha-vacia"></span>
                            }
                            @fila.Label
                        </td>
                        <td class="align-end tabular re-neutro" title="Pendiente fuente de Comodato">—</td>
                        <td class="align-end tabular">@FormatoNumero(fila.Asignacion.Full)</td>
                        <td class="align-end tabular">@FormatoNumero(fila.Asignacion.Sencillo)</td>
                        <td class="align-end tabular">@FormatoNumero(fila.Asignacion.Total)</td>
                        <td class="align-end tabular">@FormatoPct(fila.Asignacion.PctComodato)</td>
                        <td class="align-end tabular @(fila.Asignacion.DeltaPuntosPorcentuales is null ? "re-neutro" : fila.Asignacion.DeltaPuntosPorcentuales >= 0 ? "re-pos" : "re-neg")">
                            @(fila.Asignacion.DeltaPuntosPorcentuales is null ? "—" : $"{ResumenEjecutivoCalculator.FormatoPorcentaje(fila.Asignacion.DeltaPuntosPorcentuales.Value)} pp")
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @{ var totalAsig = ResumenEjecutivoCalculator.CalcularAsignacion(Raiz); }
                <tr class="re-total">
                    <td>TOTAL</td>
                    <td class="align-end tabular re-neutro" title="Pendiente fuente de Comodato">—</td>
                    <td class="align-end tabular">@FormatoNumero(totalAsig.Full)</td>
                    <td class="align-end tabular">@FormatoNumero(totalAsig.Sencillo)</td>
                    <td class="align-end tabular">@FormatoNumero(totalAsig.Total)</td>
                    <td class="align-end tabular">@FormatoPct(totalAsig.PctComodato)</td>
                    <td class="align-end tabular @(totalAsig.DeltaPuntosPorcentuales is null ? "re-neutro" : totalAsig.DeltaPuntosPorcentuales >= 0 ? "re-pos" : "re-neg")">
                        @(totalAsig.DeltaPuntosPorcentuales is null ? "—" : $"{ResumenEjecutivoCalculator.FormatoPorcentaje(totalAsig.DeltaPuntosPorcentuales.Value)} pp")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="re-nota">Comodato: <b>pendiente de fuente de datos</b> -- "armado" (columna real de nuestro SP) por ahora solo distingue Full/Sencillo; Comodato no se inventa desde ningún otro campo. %Comodato y Δ pp se muestran como "—" mientras eso siga así, y sus columnas no son ordenables (ordenar por un valor siempre igual no aporta nada). Si sube la participación de Comodato el día que se confirme su fuente, se mueve más producto por viaje y bajan los viajes sencillos. Δ pp es diferencia de puntos porcentuales (no variación relativa) -- el TOTAL se recalcula desde la raíz, nunca promediando los % de cada fila.</p>
    @if (ArmadosDesconocidos.Count > 0)
    {
        <p class="re-nota" style="color:var(--vz-later,var(--vz-acc));">
            Se detectaron @FormatoNumero(ArmadosDesconocidos.Sum(a => a.Viajes)) viaje(s) con "armado" no reconocido (ni Full ni Sencillo):
            @string.Join(", ", ArmadosDesconocidos.Select(a => $"{a.Valor} ({FormatoNumero(a.Viajes)})")).
            No se clasifican como Full ni Sencillo -- quedan excluidos del Total hasta confirmar su categoría real.
        </p>
    }
</section>

<section class="re-bloque re-frecuencia">
    <h3>Frecuencia por agencia</h3>

    <div class="re-tbl-wrap">
        <table class="re-tabla">
            <thead>
                <tr>
                    <th class="re-th-dim @ClaseOrdenFrec("label")" @onclick='() => OrdenarFrecPor("label")'>Nivel @FlechaFrec("label")</th>
                    <th class="@ClaseOrdenFrec("viajesAnt")" @onclick='() => OrdenarFrecPor("viajesAnt")'>Viajes @MesAnterior@FlechaFrec("viajesAnt")</th>
                    <th class="@ClaseOrdenFrec("viajesUlt")" @onclick='() => OrdenarFrecPor("viajesUlt")'>Viajes @MesUltimo@FlechaFrec("viajesUlt")</th>
                    <th class="@ClaseOrdenFrec("deltaViajes")" @onclick='() => OrdenarFrecPor("deltaViajes")'>Δ Viajes @FlechaFrec("deltaViajes")</th>
                    <th class="@ClaseOrdenFrec("pct")" @onclick='() => OrdenarFrecPor("pct")'>%@FlechaFrec("pct")</th>
                    <th class="@ClaseOrdenFrec("ventaUlt")" @onclick='() => OrdenarFrecPor("ventaUlt")'>Venta @MesUltimo @FlechaFrec("ventaUlt")</th>
                    <th>Señal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in tablaFrecuencia)
                {
                    <tr class="@(f.Alerta ? "re-fila-alerta" : "")">
                        <td class="re-th-dim" style="padding-left:@(8 + f.Nivel * 14)px;">@f.Label</td>
                        <td class="align-end tabular">@FormatoNumero(f.ViajesAnterior)</td>
                        <td class="align-end tabular">@FormatoNumero(f.ViajesUltimo)</td>
                        <td class="align-end tabular @ClaseDelta(f.DeltaPorcentaje)">@FormatoDeltaAbs(f.ViajesUltimo - f.ViajesAnterior)</td>
                        <td class="align-end tabular @ClaseDelta(f.DeltaPorcentaje)">@FormatoPct(f.DeltaPorcentaje)</td>
                        <td class="align-end tabular">@FormatoDinero(f.VentaUltimo)</td>
                        <td class="@(f.Alerta ? "re-neg" : "re-neutro")">@(f.Alerta ? "⚠ Revisar" : "")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @{
                    var deltaViajesFrecTot = Raiz.Ultimo.Viajes - Raiz.Anterior.Viajes;
                    var pctFrecTot = Delta(Raiz.Anterior.Viajes, Raiz.Ultimo.Viajes);
                }
                <tr class="re-total">
                    <td>TOTAL</td>
                    <td class="align-end tabular">@FormatoNumero(Raiz.Anterior.Viajes)</td>
                    <td class="align-end tabular">@FormatoNumero(Raiz.Ultimo.Viajes)</td>
                    <td class="align-end tabular @ClaseDelta(pctFrecTot)">@FormatoDeltaAbs(deltaViajesFrecTot)</td>
                    <td class="align-end tabular @ClaseDelta(pctFrecTot)">@FormatoPct(pctFrecTot)</td>
                    <td class="align-end tabular">@FormatoDinero(Raiz.Ultimo.Venta)</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="re-nota">Alerta: Δ Viajes ≤ -15% con base del mes anterior ≥ 20 viajes (misma regla que el semáforo -- ahí solo se listan las de nivel Matriz/Sucursal o más profundo; esta tabla muestra todos los niveles). Orden inicial: % ascendente (mayores caídas primero), igual que RE_jerFrec. La celda "Señal" del TOTAL queda vacía, igual que RE_pintaJerFrec (no se evalúa alerta para la fila TOTAL).</p>
</section>

@code {
    [Parameter, EditorRequired] public NodoComparativo Raiz { get; set; } = null!;
    [Parameter] public string? MesUltimo { get; set; }
    [Parameter] public string? MesAnterior { get; set; }
    [Parameter] public IReadOnlyList<(string Valor, decimal Viajes)> ArmadosDesconocidos { get; set; } = [];

    // Estado de orden INDEPENDIENTE por tabla -- ordenar una no afecta a las otras 2 (ni a
    // ninguna otra sección del Resumen). Defaults confirmados contra viajes_v14.html.
    private string ordenCompClave = "ventaUlt";
    private bool ordenCompDescendente = true;

    private string ordenAsigClave = "total";
    private bool ordenAsigDescendente = true;

    private string ordenFrecClave = "pct";
    private bool ordenFrecDescendente; // false = ascendente = mayores caídas primero (RE_jerFrec, idx=4 dir=-1)

    private List<FilaFrecuenciaDto> tablaFrecuencia = [];

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-MX");

    private sealed record FilaComparativa(int Nivel, string Label, NodoComparativo Nodo, NodoComparativo NodoOriginal, bool EsHoja);
    private sealed record FilaAsignacion(int Nivel, string Label, NodoComparativo NodoOriginal, bool EsHoja, AsignacionExpedicionDto Asignacion);

    protected override void OnParametersSet() => tablaFrecuencia = ResumenEjecutivoCalculator.ConstruirTablaFrecuencia(Raiz, CompararFrec);

    private void Alternar(NodoComparativo nodo) => nodo.IsExpanded = !nodo.IsExpanded;

    private const int ProfundidadMaxima = 4;

    private List<FilaComparativa> Aplanar(Comparison<NodoComparativo> comparador)
    {
        var filas = new List<FilaComparativa>();
        Caminar(Raiz, 0, filas, comparador);
        return filas;
    }

    private void Caminar(NodoComparativo nodo, int nivelFila, List<FilaComparativa> filas, Comparison<NodoComparativo> comparador)
    {
        var hijos = nodo.Hijos.Values.ToList();
        hijos.Sort(comparador);

        foreach (var hijoOriginal in hijos)
        {
            var efectivo = hijoOriginal;
            var nivelEfectivo = nivelFila;
            while (nivelEfectivo < ProfundidadMaxima - 1 && efectivo.Hijos.Count == 1)
            {
                efectivo = efectivo.Hijos.Values.Single();
                nivelEfectivo++;
            }

            var esHoja = nivelEfectivo == ProfundidadMaxima - 1 || efectivo.Hijos.Count == 0;
            filas.Add(new FilaComparativa(nivelFila, hijoOriginal.Label, efectivo, hijoOriginal, esHoja));

            if (!esHoja && hijoOriginal.IsExpanded)
                Caminar(efectivo, nivelFila + 1, filas, comparador);
        }
    }

    // ---------- Comparativo ----------

    private void OrdenarCompPor(string clave)
    {
        if (ordenCompClave == clave) ordenCompDescendente = !ordenCompDescendente;
        else { ordenCompClave = clave; ordenCompDescendente = clave != "label"; }
    }

    private string ClaseOrdenComp(string clave) => ordenCompClave == clave ? "re-th-ord is-active" : "re-th-ord";

    private string FlechaComp(string clave) => ordenCompClave == clave ? (ordenCompDescendente ? " ▼" : " ▲") : "";

    private decimal ValorOrdenComp(NodoComparativo n) => ordenCompClave switch
    {
        "viajesUlt" => n.Ultimo.Viajes,
        "deltaViajes" => Delta(n.Anterior.Viajes, n.Ultimo.Viajes) ?? 0,
        "kmUlt" => n.Ultimo.Kms,
        "deltaKm" => Delta(n.Anterior.Kms, n.Ultimo.Kms) ?? 0,
        "deltaVenta" => Delta(n.Anterior.Venta, n.Ultimo.Venta) ?? 0,
        "viajesAnio" => n.Anual.Viajes,
        "kmAnio" => n.Anual.Kms,
        "ventaAnio" => n.Anual.Venta,
        _ => n.Ultimo.Venta, // "ventaUlt" (default)
    };

    private int CompararComp(NodoComparativo a, NodoComparativo b)
    {
        if (ordenCompClave == "label")
        {
            var cmpTxt = string.Compare(a.Label, b.Label, StringComparison.CurrentCultureIgnoreCase);
            return ordenCompDescendente ? -cmpTxt : cmpTxt;
        }

        var cmp = ValorOrdenComp(a).CompareTo(ValorOrdenComp(b));
        return ordenCompDescendente ? -cmp : cmp;
    }

    private void OrdenarAsigPor(string clave)
    {
        if (ordenAsigClave == clave) ordenAsigDescendente = !ordenAsigDescendente;
        else { ordenAsigClave = clave; ordenAsigDescendente = clave != "label"; }
    }

    private string ClaseOrdenAsig(string clave) => ordenAsigClave == clave ? "re-th-ord is-active" : "re-th-ord";

    private string FlechaAsig(string clave) => ordenAsigClave == clave ? (ordenAsigDescendente ? " ▼" : " ▲") : "";

    private decimal ValorOrdenAsig(NodoComparativo n)
    {
        var a = ResumenEjecutivoCalculator.CalcularAsignacion(n);
        return ordenAsigClave switch
        {
            "full" => a.Full,
            "sencillo" => a.Sencillo,
            _ => a.Total, // "total" (default)
        };
    }

    private int CompararAsig(NodoComparativo a, NodoComparativo b)
    {
        if (ordenAsigClave == "label")
        {
            var cmpTxt = string.Compare(a.Label, b.Label, StringComparison.CurrentCultureIgnoreCase);
            return ordenAsigDescendente ? -cmpTxt : cmpTxt;
        }

        var cmp = ValorOrdenAsig(a).CompareTo(ValorOrdenAsig(b));
        return ordenAsigDescendente ? -cmp : cmp;
    }

    private List<FilaAsignacion> FilasAsignacion() =>
        Aplanar(CompararAsig).Select(f => new FilaAsignacion(f.Nivel, f.Label, f.NodoOriginal, f.EsHoja, ResumenEjecutivoCalculator.CalcularAsignacion(f.Nodo))).ToList();

    private void OrdenarFrecPor(string clave)
    {
        if (ordenFrecClave == clave) ordenFrecDescendente = !ordenFrecDescendente;
        else { ordenFrecClave = clave; ordenFrecDescendente = clave != "label"; }
        tablaFrecuencia = ResumenEjecutivoCalculator.ConstruirTablaFrecuencia(Raiz, CompararFrec);
    }

    private string ClaseOrdenFrec(string clave) => ordenFrecClave == clave ? "re-th-ord is-active" : "re-th-ord";

    private string FlechaFrec(string clave) => ordenFrecClave == clave ? (ordenFrecDescendente ? " ▼" : " ▲") : "";

    private decimal ValorOrdenFrec(NodoComparativo n) => ordenFrecClave switch
    {
        "viajesAnt" => n.Anterior.Viajes,
        "viajesUlt" => n.Ultimo.Viajes,
        "deltaViajes" => n.Ultimo.Viajes - n.Anterior.Viajes,
        "ventaUlt" => n.Ultimo.Venta,
        _ => n.Anterior.Viajes > 0 ? (n.Ultimo.Viajes - n.Anterior.Viajes) / n.Anterior.Viajes * 100 : 0, // "pct" (default)
    };

    private int CompararFrec(NodoComparativo a, NodoComparativo b)
    {
        if (ordenFrecClave == "label")
        {
            var cmpTxt = string.Compare(a.Label, b.Label, StringComparison.CurrentCultureIgnoreCase);
            return ordenFrecDescendente ? -cmpTxt : cmpTxt;
        }

        var cmp = ValorOrdenFrec(a).CompareTo(ValorOrdenFrec(b));
        return ordenFrecDescendente ? -cmp : cmp;
    }

    // ---------- Compartidos ----------

    private static decimal? Delta(decimal anterior, decimal ultimo) => anterior > 0 ? (ultimo - anterior) / anterior * 100 : null;

    private static string ClaseDelta(decimal? v) => v switch { null => "re-neutro", > 0 => "re-pos", < 0 => "re-neg", _ => "re-neutro" };

    private static string FormatoPct(decimal? v) => v is null ? "—" : ResumenEjecutivoCalculator.FormatoPorcentaje(v.Value);

    private static string FormatoDeltaAbs(decimal delta) => (delta >= 0 ? "+" : "") + FormatoNumero(delta);

    private static string FormatoNumero(decimal v) => Math.Round(v).ToString("N0", Cultura);
    private static string FormatoDinero(decimal v) => v.ToString("C0", Cultura);
}